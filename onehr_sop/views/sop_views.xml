<odoo>
    <record id="view_onehr_sop_list" model="ir.ui.view">
        <field name="name">onehr.sop.list.enterprise</field>
        <field name="model">onehr.sop</field>
        <field name="arch" type="xml">
            <list string="Standard Operating Procedures"
                  decoration-success="current_ack_rate >= 90.0 and not review_overdue"
                  decoration-warning="review_overdue"
                  decoration-danger="current_pending_count > 0 and current_review_due_date"
                  decoration-muted="not active">
                <field name="current_version_id" column_invisible="True"/>
                <field name="code"/>
                <field name="name"/>
                <field name="owner_name"/>
                <field name="lifecycle_state" widget="badge"
                       groups="onehr_sop.group_onehr_sop_editor"/>
                <field name="version_count"
                       groups="onehr_sop.group_onehr_sop_editor"/>
                <field name="current_ack_count"/>
                <field name="current_acknowledged_count"/>
                <field name="current_pending_count"/>
                <field name="current_ack_rate" widget="percentage"/>
                <field name="days_to_90_ack" optional="hide"/>
                <field name="current_review_due_date"/>
                <field name="review_overdue" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" optional="hide"/>
                <button name="action_open_current_version" type="object"
                        string="Open SOP" icon="fa-book"
                        invisible="not current_version_id"/>
                <button name="action_create_new_version" type="object"
                        string="New Version" icon="fa-copy"
                        groups="onehr_sop.group_onehr_sop_editor"/>
            </list>
        </field>
    </record>

    <record id="view_onehr_sop_kanban" model="ir.ui.view">
        <field name="name">onehr.sop.kanban.enterprise</field>
        <field name="model">onehr.sop</field>
        <field name="arch" type="xml">
            <kanban default_group_by="lifecycle_state">
                <field name="code"/>
                <field name="name"/>
                <field name="owner_name"/>
                <field name="lifecycle_state"/>
                <field name="current_ack_rate"/>
                <field name="current_pending_count"/>
                <field name="current_review_due_date"/>
                <field name="review_overdue"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start">
                            <strong><field name="name"/></strong>
                            <field name="lifecycle_state" widget="badge"/>
                        </div>
                        <div class="text-muted"><field name="code"/></div>
                        <div class="mt-2">
                            <strong>Owner:</strong> <field name="owner_name"/>
                        </div>
                        <div class="mt-2">
                            <strong>Acknowledgement:</strong>
                            <field name="current_ack_rate" widget="percentage"/>
                        </div>
                        <div t-if="record.current_pending_count.raw_value">
                            <strong>Pending:</strong> <field name="current_pending_count"/>
                        </div>
                        <div t-if="record.current_review_due_date.raw_value">
                            <strong>Review Due:</strong> <field name="current_review_due_date"/>
                        </div>
                        <div class="mt-1" t-if="record.review_overdue.raw_value">
                            <span class="badge text-bg-warning">Review Overdue</span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_onehr_sop_form" model="ir.ui.view">
        <field name="name">onehr.sop.form.enterprise</field>
        <field name="model">onehr.sop</field>
        <field name="arch" type="xml">
            <form string="Standard Operating Procedure">
                <header>
                    <button name="action_create_new_version" type="object"
                            string="Create New Version" class="btn-primary"
                            groups="onehr_sop.group_onehr_sop_editor"/>
                    <button name="action_archive_master" type="object"
                            string="Archive SOP"
                            invisible="not active"
                            groups="onehr_sop.group_onehr_sop_admin"/>
                    <field name="lifecycle_state" widget="statusbar"
                           statusbar_visible="draft,review,approved,published,obsolete"
                           groups="onehr_sop.group_onehr_sop_editor"/>
                </header>

                <sheet>
                    <field name="current_version_id" invisible="1"/>
                    <field name="review_overdue" invisible="1"/>
                    <field name="active" invisible="1"/>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_current_version" type="object"
                                class="oe_stat_button" icon="fa-book"
                                invisible="not current_version_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Current SOP</span>
                            </div>
                        </button>
                        <button name="action_open_versions" type="object"
                                class="oe_stat_button" icon="fa-history"
                                groups="onehr_sop.group_onehr_sop_editor">
                            <field name="version_count" widget="statinfo" string="Versions"/>
                        </button>
                        <button name="action_open_acknowledgements" type="object"
                                class="oe_stat_button" icon="fa-check-square-o"
                                invisible="not current_version_id">
                            <field name="current_ack_count" widget="statinfo" string="Audience"/>
                        </button>
                        <button name="action_open_archive_document" type="object"
                                class="oe_stat_button" icon="fa-archive"
                                groups="onehr_sop.group_onehr_sop_editor"
                                invisible="not archive_document_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Document Archive</span>
                            </div>
                        </button>
                        <button name="action_print_current_sop" type="object"
                                class="oe_stat_button" icon="fa-file-pdf-o"
                                invisible="not current_version_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Print Current</span>
                            </div>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Review Overdue"
                            bg_color="text-bg-warning"
                            invisible="not review_overdue"/>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-secondary"
                            invisible="active"/>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Employee Onboarding SOP"/></h1>
                        <div class="text-muted"><field name="code" readonly="1"/></div>
                    </div>

                    <group>
                        <group string="SOP Identity">
                            <field name="owner_name" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="current_version_id"/>
                            <field name="active"
                                   groups="onehr_sop.group_onehr_sop_editor"/>
                        </group>
                        <group string="Current Compliance">
                            <field name="current_ack_count" readonly="1"/>
                            <field name="current_acknowledged_count" readonly="1"/>
                            <field name="current_pending_count" readonly="1"/>
                            <field name="current_ack_rate" widget="progressbar" readonly="1"/>
                            <field name="days_to_90_ack" readonly="1"/>
                            <field name="current_review_due_date" readonly="1"/>
                        </group>
                    </group>

                    <div class="d-flex gap-2 mb-3">
                        <button name="action_open_current_version" type="object"
                                string="Read Current SOP"
                                class="btn-secondary"
                                invisible="not current_version_id"/>
                        <button name="action_print_current_sop" type="object"
                                string="Print Current SOP"
                                class="btn-secondary"
                                invisible="not current_version_id"/>
                        <button name="action_create_new_version" type="object"
                                string="Start Controlled Revision"
                                class="btn-secondary"
                                groups="onehr_sop.group_onehr_sop_editor"/>
                    </div>

                    <notebook>
                        <page string="Governance Configuration"
                              groups="onehr_sop.group_onehr_sop_editor">
                            <group>
                                <group string="Ownership &amp; Approval">
                                    <field name="owner_user_id"/>
                                    <field name="reviewer_user_ids" widget="many2many_tags"/>
                                    <field name="approver_user_ids" widget="many2many_tags"/>
                                    <field name="document_category_id"/>
                                    <field name="archive_document_id" readonly="1"/>
                                </group>
                                <group string="Review, Retention &amp; Notification">
                                    <field name="review_interval_months"/>
                                    <field name="retention_years"/>
                                    <field name="ack_reminder_days"/>
                                    <field name="publication_template_id"/>
                                    <field name="reminder_template_id"/>
                                    <field name="auto_email_reminders"/>
                                </group>
                            </group>
                            <field name="notes"
                                   placeholder="Governance rationale, review cycle, exception handling..."/>
                        </page>

                        <page string="Version History"
                              groups="onehr_sop.group_onehr_sop_editor">
                            <field name="version_ids">
                                <list create="false" delete="false"
                                      decoration-success="state == 'published' and is_current"
                                      decoration-info="state == 'review'"
                                      decoration-warning="state == 'approved'"
                                      decoration-muted="state == 'obsolete'">
                                    <field name="previous_version_id" column_invisible="True"/>
                                    <field name="version_no"/>
                                    <field name="name"/>
                                    <field name="state" widget="badge"/>
                                    <field name="is_current"/>
                                    <field name="effective_from"/>
                                    <field name="effective_to"/>
                                    <field name="review_due_date"/>
                                    <field name="ack_count"/>
                                    <field name="ack_rate" widget="percentage"/>
                                    <field name="published_at"/>
                                    <button name="action_open_version" type="object"
                                            string="Open" icon="fa-external-link"/>
                                    <button name="action_submit_review" type="object"
                                            string="Submit" icon="fa-paper-plane"
                                            invisible="state != 'draft'"/>
                                    <button name="action_approve" type="object"
                                            string="Approve" icon="fa-check"
                                            invisible="state != 'review'"
                                            groups="onehr_sop.group_onehr_sop_approver"/>
                                    <button name="action_publish" type="object"
                                            string="Publish" icon="fa-bullhorn"
                                            invisible="state != 'approved'"
                                            groups="onehr_sop.group_onehr_sop_approver"/>
                                    <button name="action_print_compliance" type="object"
                                            string="Compliance" icon="fa-bar-chart"
                                            invisible="state not in ('published', 'obsolete')"
                                            groups="onehr_sop.group_onehr_sop_approver"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                    <chatter groups="onehr_sop.group_onehr_sop_editor"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_onehr_sop_search" model="ir.ui.view">
        <field name="name">onehr.sop.search.enterprise</field>
        <field name="model">onehr.sop</field>
        <field name="arch" type="xml">
            <search string="Search SOPs">
                <field name="code"/>
                <field name="name"/>
                <field name="owner_name"/>
                <filter name="published" string="Published"
                        domain="[('current_version_id', '!=', False)]"/>
                <filter name="review_overdue" string="Review Overdue"
                        domain="[('review_overdue', '=', True)]"/>
                <filter name="pending_ack" string="Pending Acknowledgements"
                        domain="[('current_pending_count', '&gt;', 0)]"/>
                <filter name="compliant_90" string="90%+ Acknowledged"
                        domain="[('current_ack_rate', '&gt;=', 90.0)]"/>
                <filter name="active" string="Active"
                        domain="[('active', '=', True)]"/>
                <separator/>
                <group>
                    <filter name="group_state" string="Lifecycle"
                            context="{'group_by': 'lifecycle_state'}"
                            groups="onehr_sop.group_onehr_sop_editor"/>
                    <filter name="group_owner" string="Owner"
                            context="{'group_by': 'owner_user_id'}"
                            groups="onehr_sop.group_onehr_sop_editor"/>
                    <filter name="group_company" string="Company"
                            context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_onehr_sop_pivot" model="ir.ui.view">
        <field name="name">onehr.sop.pivot.enterprise</field>
        <field name="model">onehr.sop</field>
        <field name="arch" type="xml">
            <pivot string="SOP Governance Portfolio">
                <field name="lifecycle_state" type="row"/>
                <field name="current_ack_rate" type="measure"/>
                <field name="current_ack_count" type="measure"/>
                <field name="current_pending_count" type="measure"/>
                <field name="days_to_90_ack" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_onehr_sop_graph" model="ir.ui.view">
        <field name="name">onehr.sop.graph.enterprise</field>
        <field name="model">onehr.sop</field>
        <field name="arch" type="xml">
            <graph string="SOP Acknowledgement Portfolio" type="bar">
                <field name="lifecycle_state"/>
                <field name="current_ack_rate" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_onehr_sop_my_published" model="ir.actions.act_window">
        <field name="name">My Published SOPs</field>
        <field name="res_model">onehr.sop</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_onehr_sop_search"/>
        <field name="domain">[('current_version_id', '!=', False), ('active', '=', True)]</field>
    </record>

    <record id="action_onehr_sop_all" model="ir.actions.act_window">
        <field name="name">SOP Register</field>
        <field name="res_model">onehr.sop</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_onehr_sop_search"/>
    </record>

    <record id="action_onehr_sop_review_watch" model="ir.actions.act_window">
        <field name="name">SOP Review Watch</field>
        <field name="res_model">onehr.sop</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_onehr_sop_search"/>
        <field name="domain">[('current_version_id', '!=', False), ('active', '=', True)]</field>
    </record>

    <record id="action_onehr_sop_analytics" model="ir.actions.act_window">
        <field name="name">SOP Compliance Analytics</field>
        <field name="res_model">onehr.sop</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_onehr_sop_search"/>
        <field name="domain">[('active', '=', True)]</field>
    </record>
</odoo>
