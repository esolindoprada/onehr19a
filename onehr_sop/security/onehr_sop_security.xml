<odoo>
    <record id="module_category_onehr_sop" model="ir.module.category">
        <field name="name">OneHR SOP</field>
        <field name="description">Standard Operating Procedure governance, publication and compliance.</field>
        <field name="sequence">53</field>
    </record>

    <record id="privilege_onehr_sop" model="res.groups.privilege">
        <field name="name">OneHR SOP</field>
        <field name="description">SOP reader, QA/editor, approval and administration authority.</field>
        <field name="category_id" ref="module_category_onehr_sop"/>
        <field name="sequence">53</field>
    </record>

    <record id="group_onehr_sop_reader" model="res.groups">
        <field name="name">SOP Reader</field>
        <field name="privilege_id" ref="privilege_onehr_sop"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[
            Command.link(ref('onehr_security.group_onehr_security_user'))
        ]"/>
        <field name="comment">Reads only current published SOPs assigned to the user's employee audience and records own Read &amp; Agree.</field>
    </record>

    <record id="group_onehr_sop_editor" model="res.groups">
        <field name="name">SOP QA / Editor</field>
        <field name="privilege_id" ref="privilege_onehr_sop"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[
            Command.link(ref('onehr_sop.group_onehr_sop_reader')),
            Command.link(ref('hr.group_hr_user')),
            Command.link(ref('onehr_document.group_onehr_document_officer'))
        ]"/>
        <field name="comment">Maintains SOP masters and Draft content, resolves targeted employee audiences and works with non-restricted Document archives.</field>
    </record>

    <record id="group_onehr_sop_approver" model="res.groups">
        <field name="name">SOP Compliance / Approver</field>
        <field name="privilege_id" ref="privilege_onehr_sop"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[
            Command.link(ref('onehr_sop.group_onehr_sop_editor')),
            Command.link(ref('onehr_document.group_onehr_document_manager'))
        ]"/>
        <field name="comment">Approves/publishes SOPs, generates acknowledgement evidence, manages audit exports and archives published snapshots into OneHR Document.</field>
    </record>

    <record id="group_onehr_sop_admin" model="res.groups">
        <field name="name">SOP Administrator</field>
        <field name="privilege_id" ref="privilege_onehr_sop"/>
        <field name="sequence">40</field>
        <field name="implied_ids" eval="[
            Command.link(ref('onehr_sop.group_onehr_sop_approver'))
        ]"/>
        <field name="comment">Administrative SOP authority. Historical published/acknowledgement evidence remains protected by model guards.</field>
    </record>
</odoo>
