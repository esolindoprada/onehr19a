<odoo>
    <record id="module_category_onehr_appraisal" model="ir.module.category">
        <field name="name">OneHR Appraisal</field>
        <field name="description">OneHR performance management, multi-rater review and calibration.</field>
        <field name="sequence">48</field>
    </record>

    <record id="privilege_onehr_appraisal" model="res.groups.privilege">
        <field name="name">OneHR Appraisal</field>
        <field name="description">Performance appraisal operational privileges.</field>
        <field name="category_id" ref="module_category_onehr_appraisal"/>
        <field name="sequence">48</field>
    </record>

    <record id="group_onehr_appraisal_participant" model="res.groups">
        <field name="name">Appraisal Participant</field>
        <field name="privilege_id" ref="privilege_onehr_appraisal"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[Command.link(ref('onehr_security.group_onehr_security_user'))]"/>
        <field name="comment">Self/peer appraisal evidence only; no cycle administration.</field>
    </record>

    <record id="group_onehr_appraisal_manager" model="res.groups">
        <field name="name">Appraisal Manager</field>
        <field name="privilege_id" ref="privilege_onehr_appraisal"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[Command.link(ref('onehr_appraisal.group_onehr_appraisal_participant'))]"/>
        <field name="comment">Manager review authority for assigned team appraisal forms.</field>
    </record>

    <record id="group_onehr_appraisal_hr" model="res.groups">
        <field name="name">Appraisal HR Officer</field>
        <field name="privilege_id" ref="privilege_onehr_appraisal"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[
            Command.link(ref('onehr_appraisal.group_onehr_appraisal_manager')),
            Command.link(ref('hr.group_hr_user'))
        ]"/>
        <field name="comment">Company-scoped appraisal monitoring and cycle/form/score administration.</field>
    </record>

    <record id="group_onehr_appraisal_admin" model="res.groups">
        <field name="name">Appraisal HR Manager</field>
        <field name="privilege_id" ref="privilege_onehr_appraisal"/>
        <field name="sequence">40</field>
        <field name="implied_ids" eval="[
            Command.link(ref('onehr_appraisal.group_onehr_appraisal_hr')),
            Command.link(ref('hr.group_hr_manager'))
        ]"/>
        <field name="comment">Highest Appraisal authority for controlled reset/cancel/delete operations.</field>
    </record>
</odoo>
