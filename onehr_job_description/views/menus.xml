<odoo>
    <!-- The Reader role may be intentionally granted without an HR officer role.
         Link it to the existing OneHR root without modifying onehr_base source. -->
    <record id="onehr_base.menu_onehr_root" model="ir.ui.menu">
        <field name="group_ids" eval="[
            Command.link(ref('onehr_job_description.group_onehr_jd_reader'))
        ]"/>
    </record>

    <menuitem id="menu_onehr_governance_root"
              name="Governance"
              parent="onehr_base.menu_onehr_root"
              sequence="65"
              groups="onehr_job_description.group_onehr_jd_reader"/>

    <menuitem id="menu_onehr_job_descriptions"
              name="Job Descriptions"
              parent="menu_onehr_governance_root"
              action="action_onehr_jd"
              sequence="10"/>

    <menuitem id="menu_onehr_jd_review_watch"
              name="Review Watch"
              parent="menu_onehr_governance_root"
              action="action_onehr_jd_review_watch"
              sequence="20"
              groups="onehr_job_description.group_onehr_jd_editor"/>

    <menuitem id="menu_onehr_jd_versions"
              name="Version History"
              parent="menu_onehr_governance_root"
              action="action_onehr_jd_versions"
              sequence="30"
              groups="onehr_job_description.group_onehr_jd_editor"/>

    <menuitem id="menu_onehr_jd_analytics"
              name="JD Coverage Analytics"
              parent="menu_onehr_governance_root"
              action="action_onehr_jd_analytics"
              sequence="40"
              groups="onehr_job_description.group_onehr_jd_approver"/>

    <menuitem id="menu_onehr_jd_configuration"
              name="Configuration"
              parent="menu_onehr_governance_root"
              sequence="90"
              groups="onehr_job_description.group_onehr_jd_editor"/>

    <menuitem id="menu_onehr_jd_templates"
              name="JD Templates"
              parent="menu_onehr_jd_configuration"
              action="action_onehr_jd_templates"
              sequence="10"/>
</odoo>
