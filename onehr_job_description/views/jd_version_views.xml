<odoo>
    <record id="view_onehr_jd_version_list" model="ir.ui.view">
        <field name="name">onehr.jd.version.list.enterprise</field>
        <field name="model">onehr.jd.version</field>
        <field name="arch" type="xml">
            <list string="Job Description Versions"
                  decoration-success="state == 'published' and is_current"
                  decoration-info="state == 'review'"
                  decoration-warning="state == 'approved'"
                  decoration-muted="state == 'published' and not is_current">
                <field name="previous_version_id" column_invisible="True"
                       groups="onehr_job_description.group_onehr_jd_editor"/>
                <field name="jd_id"/>
                <field name="version_no"/>
                <field name="name"/>
                <field name="position_name"/>
                <field name="job_family_name"/>
                <field name="department_name"/>
                <field name="state" widget="badge"/>
                <field name="is_current"/>
                <field name="completeness_percent"/>
                <field name="effective_from"/>
                <field name="effective_to"/>
                <field name="review_due_date"/>
                <field name="approved_at" optional="hide"/>
                <field name="published_at"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <button name="action_open_version" type="object"
                        string="Open" icon="fa-external-link"/>
                <button name="action_submit_review" type="object"
                        string="Submit" icon="fa-paper-plane"
                        invisible="state != 'draft'"
                        groups="onehr_job_description.group_onehr_jd_editor"/>
                <button name="action_approve" type="object"
                        string="Approve" icon="fa-check"
                        invisible="state != 'review'"
                        groups="onehr_job_description.group_onehr_jd_approver"/>
                <button name="action_publish" type="object"
                        string="Publish" icon="fa-bullhorn"
                        invisible="state != 'approved'"
                        groups="onehr_job_description.group_onehr_jd_approver"/>
                <button name="action_print_comparison" type="object"
                        string="Compare" icon="fa-columns"
                        invisible="not previous_version_id"/>
            </list>
        </field>
    </record>

    <record id="view_onehr_jd_version_form" model="ir.ui.view">
        <field name="name">onehr.jd.version.form.enterprise</field>
        <field name="model">onehr.jd.version</field>
        <field name="arch" type="xml">
            <form string="Job Description Version">
                <header>
                    <button name="action_submit_review" type="object"
                            string="Submit for Review" class="btn-primary"
                            invisible="state != 'draft'"
                            groups="onehr_job_description.group_onehr_jd_editor"/>
                    <button name="action_return_draft" type="object"
                            string="Return to Draft"
                            invisible="state not in ('review', 'approved')"
                            groups="onehr_job_description.group_onehr_jd_approver"/>
                    <button name="action_approve" type="object"
                            string="Approve" class="btn-primary"
                            invisible="state != 'review'"
                            groups="onehr_job_description.group_onehr_jd_approver"/>
                    <button name="action_publish" type="object"
                            string="Publish" class="btn-primary"
                            invisible="state != 'approved'"
                            groups="onehr_job_description.group_onehr_jd_approver"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,review,approved,published"/>
                </header>

                <sheet>
                    <field name="is_template" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_master_jd" type="object"
                                class="oe_stat_button" icon="fa-book">
                            <div class="o_stat_info">
                                <span class="o_stat_text">JD Master</span>
                            </div>
                        </button>
                        <button name="action_open_previous_version" type="object"
                                class="oe_stat_button" icon="fa-history"
                                invisible="not previous_version_id"
                                groups="onehr_job_description.group_onehr_jd_editor">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Previous</span>
                            </div>
                        </button>
                        <button name="action_print_jd" type="object"
                                class="oe_stat_button" icon="fa-file-pdf-o">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Print JD</span>
                            </div>
                        </button>
                        <button name="action_print_comparison" type="object"
                                class="oe_stat_button" icon="fa-columns"
                                invisible="not previous_version_id"
                                groups="onehr_job_description.group_onehr_jd_editor">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Compare</span>
                            </div>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="CURRENT"
                            bg_color="text-bg-success"
                            invisible="not is_current"/>
                    <widget name="web_ribbon" title="Template"
                            bg_color="text-bg-info"
                            invisible="not is_template or is_current"/>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                        <div class="text-muted">
                            <field name="position_name"/> · <field name="job_family_name"/>
                        </div>
                    </div>

                    <group>
                        <group string="Version Identity">
                            <field name="jd_id" readonly="state != 'draft'"/>
                            <field name="version_no" readonly="1"/>
                            <field name="previous_version_id" readonly="1"/>
                            <field name="is_current" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="1"/>
                        </group>
                        <group string="Effective Governance">
                            <field name="effective_from" readonly="state != 'draft'"/>
                            <field name="effective_to" readonly="state != 'draft'"/>
                            <field name="review_due_date" readonly="state != 'draft'"/>
                            <field name="completeness_percent" widget="progressbar" readonly="1"/>
                            <field name="content_fingerprint" readonly="1"
                                   invisible="not content_fingerprint"/>
                        </group>
                    </group>

                    <div class="d-flex gap-2 mb-3"
                         groups="onehr_job_description.group_onehr_jd_editor">
                        <button name="action_import_source_document" type="object"
                                string="Extract External Source"
                                class="btn-secondary"
                                invisible="state != 'draft'"/>
                        <button name="action_refresh_competency_snapshot" type="object"
                                string="Refresh Position Competencies"
                                class="btn-secondary"
                                invisible="state != 'draft' or is_template"/>
                        <button name="action_print_jd" type="object"
                                string="Print This Version"
                                class="btn-secondary"/>
                        <button name="action_print_comparison" type="object"
                                string="Compare with Previous"
                                class="btn-secondary"
                                invisible="not previous_version_id"/>
                    </div>

                    <notebook>
                        <page string="Purpose &amp; Responsibilities">
                            <field name="purpose" readonly="state != 'draft'"
                                   placeholder="Why does this position exist?"/>
                            <field name="key_responsibilities" readonly="state != 'draft'"
                                   placeholder="Primary duties, responsibilities and expected outcomes..."/>
                            <field name="accountability" readonly="state != 'draft'"/>
                            <field name="authority_scope" readonly="state != 'draft'"/>
                            <field name="reporting_relationships" readonly="state != 'draft'"/>
                        </page>

                        <page string="KPI &amp; Performance">
                            <field name="kpi_codes" readonly="state != 'draft'"
                                   placeholder="KPI-001, KPI-005, ..."/>
                            <field name="kpi_expectations" readonly="state != 'draft'"
                                   placeholder="Define KPI expectations, measures, quality and outcomes..."/>
                        </page>

                        <page string="Competencies">
                            <field name="competency_codes" readonly="state != 'draft'"/>
                            <field name="competency_requirements" readonly="state != 'draft'"/>
                            <div class="mt-2"
                                 groups="onehr_job_description.group_onehr_jd_editor">
                                <button name="action_refresh_competency_snapshot" type="object"
                                        string="Refresh from Career &amp; Succession"
                                        class="btn-secondary"
                                        invisible="state != 'draft' or is_template"/>
                            </div>
                        </page>

                        <page string="Qualifications">
                            <field name="qualification_requirements" readonly="state != 'draft'"/>
                            <field name="education_requirements" readonly="state != 'draft'"/>
                            <field name="experience_requirements" readonly="state != 'draft'"/>
                            <field name="skills_requirements" readonly="state != 'draft'"/>
                        </page>

                        <page string="HSE / K3">
                            <group>
                                <field name="hse_risk_level" readonly="state != 'draft'"/>
                            </group>
                            <field name="working_conditions" readonly="state != 'draft'"/>
                            <field name="hse_risks" readonly="state != 'draft'"/>
                            <field name="hse_controls" readonly="state != 'draft'"/>
                            <field name="ppe_requirements" readonly="state != 'draft'"/>
                        </page>

                        <page string="Change Control"
                              groups="onehr_job_description.group_onehr_jd_editor">
                            <field name="change_summary" readonly="state != 'draft'"/>
                            <field name="change_reason" readonly="state != 'draft'"/>
                            <field name="reviewer_comments" readonly="state == 'published'"/>
                            <field name="approval_comments"
                                   readonly="state == 'published'"
                                   groups="onehr_job_description.group_onehr_jd_approver"/>
                        </page>

                        <page string="External Source &amp; Evidence"
                              groups="onehr_job_description.group_onehr_jd_editor">
                            <group>
                                <field name="source_file" filename="source_filename"
                                       readonly="state != 'draft'"/>
                                <field name="source_filename" invisible="1"/>
                                <field name="source_imported_at" readonly="1"/>
                            </group>
                            <button name="action_import_source_document" type="object"
                                    string="Extract Source Text"
                                    class="btn-secondary"
                                    invisible="state != 'draft'"/>
                            <field name="source_document_text" readonly="1"
                                   placeholder="Extracted source text appears here for controlled manual migration..."/>
                            <field name="evidence_attachment_ids"
                                   widget="many2many_binary"
                                   readonly="state != 'draft'"/>
                        </page>

                        <page string="Approval Evidence"
                              groups="onehr_job_description.group_onehr_jd_editor">
                            <group>
                                <group>
                                    <field name="submitted_by_id" readonly="1"/>
                                    <field name="submitted_at" readonly="1"/>
                                    <field name="approved_by_id" readonly="1"/>
                                    <field name="approved_at" readonly="1"/>
                                </group>
                                <group>
                                    <field name="published_by_id" readonly="1"/>
                                    <field name="published_at" readonly="1"/>
                                    <field name="content_fingerprint" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>

                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_onehr_jd_version_search" model="ir.ui.view">
        <field name="name">onehr.jd.version.search.enterprise</field>
        <field name="model">onehr.jd.version</field>
        <field name="arch" type="xml">
            <search string="Search JD Versions">
                <field name="jd_id"/>
                <field name="name"/>
                <field name="position_code"/>
                <field name="position_name"/>
                <field name="job_family_name"/>
                <field name="department_name"/>
                <filter name="current" string="Current Published"
                        domain="[('state', '=', 'published'), ('is_current', '=', True)]"/>
                <filter name="draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="review" string="In Review"
                        domain="[('state', '=', 'review')]"/>
                <filter name="approved" string="Approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter name="published" string="Published History"
                        domain="[('state', '=', 'published')]"/>
                <filter name="templates" string="Template Versions"
                        domain="[('is_template', '=', True)]"/>
                <separator/>
                <group>
                    <filter name="group_state" string="State"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_jd" string="JD"
                            context="{'group_by': 'jd_id'}"/>
                    <filter name="group_company" string="Company"
                            context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_onehr_jd_version_calendar" model="ir.ui.view">
        <field name="name">onehr.jd.version.calendar.enterprise</field>
        <field name="model">onehr.jd.version</field>
        <field name="arch" type="xml">
            <calendar string="JD Review Calendar"
                      date_start="review_due_date"
                      color="jd_id">
                <field name="name"/>
                <field name="position_name"/>
                <field name="state"/>
                <field name="completeness_percent"/>
            </calendar>
        </field>
    </record>

    <record id="view_onehr_jd_version_pivot" model="ir.ui.view">
        <field name="name">onehr.jd.version.pivot.enterprise</field>
        <field name="model">onehr.jd.version</field>
        <field name="arch" type="xml">
            <pivot string="JD Version Portfolio">
                <field name="state" type="row"/>
                <field name="is_template" type="col"/>
                <field name="completeness_percent" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_onehr_jd_version_graph" model="ir.ui.view">
        <field name="name">onehr.jd.version.graph.enterprise</field>
        <field name="model">onehr.jd.version</field>
        <field name="arch" type="xml">
            <graph string="JD Version Status" type="bar">
                <field name="state"/>
                <field name="completeness_percent" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_onehr_jd_versions" model="ir.actions.act_window">
        <field name="name">JD Versions</field>
        <field name="res_model">onehr.jd.version</field>
        <field name="view_mode">list,form,calendar,pivot,graph</field>
        <field name="search_view_id" ref="view_onehr_jd_version_search"/>
    </record>
</odoo>
