  <menuitem id="menu_onehr_contract_expiry" name="Expiry Watch" parent="menu_onehr_contract_reporting" action="action_onehr_contract_expiry" sequence="20"/>
  <menuitem id="menu_onehr_contract_termination" name="Termination Reviews" parent="menu_onehr_contract_reporting" action="action_onehr_contract_termination" sequence="30"/>
  <menuitem id="menu_onehr_contract_configuration" name="Configuration" parent="menu_onehr_employment_root" sequence="90" groups="onehr_employment_contract.group_onehr_contract_manager"/>
  <menuitem id="menu_onehr_contract_templates" name="Contract Templates" parent="menu_onehr_contract_configuration" action="action_onehr_contract_template" sequence="10"/>
</odoo>
