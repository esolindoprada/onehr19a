<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="module_category_onehr_contract" model="ir.module.category">
    <field name="name">OneHR Employment Contract</field>
    <field name="description">Employment-contract governance, legal evidence, renewal and termination.</field>
    <field name="sequence">41</field>
  </record>
  <record id="privilege_onehr_contract" model="res.groups.privilege">
    <field name="name">OneHR Employment Contract</field>
    <field name="description">Governed contract operations and legal lifecycle authority.</field>
    <field name="category_id" ref="module_category_onehr_contract"/>
    <field name="sequence">41</field>
  </record>
  <record id="group_onehr_contract_line_manager" model="res.groups">
    <field name="name">Contract Line Manager</field>
    <field name="privilege_id" ref="privilege_onehr_contract"/>
    <field name="sequence">10</field>
    <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    <field name="comment">Read-only visibility for contracts of direct reports; no wage/native-version field entitlement.</field>
  </record>
  <record id="group_onehr_contract_officer" model="res.groups">
    <field name="name">Contract Officer</field>
    <field name="privilege_id" ref="privilege_onehr_contract"/>
    <field name="sequence">20</field>
    <field name="implied_ids" eval="[             Command.link(ref('hr.group_hr_user')),             Command.link(ref('onehr_workflow_approval.group_onehr_approval_user'))         ]"/>
    <field name="comment">Prepares contracts, submissions, renewals, documents and reminders; no template administration or termination execution.</field>
  </record>
  <record id="group_onehr_contract_manager" model="res.groups">
    <field name="name">Contract Manager</field>
    <field name="privilege_id" ref="privilege_onehr_contract"/>
    <field name="sequence">30</field>
    <field name="implied_ids" eval="[             Command.link(ref('group_onehr_contract_officer')),             Command.link(ref('hr.group_hr_manager')),             Command.link(ref('onehr_workflow_approval.group_onehr_approver'))         ]"/>
    <field name="comment">Template administration and high-impact activation/termination execution authority.</field>
  </record>
</odoo>
