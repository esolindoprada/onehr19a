<odoo>
    <!-- Position Hierarchy -->
    <record id="view_hierarchy_list" model="ir.ui.view"><field name="name">onehr.position.hierarchy.list.enterprise</field><field name="model">onehr.position.hierarchy</field><field name="arch" type="xml"><list decoration-muted="not active"><field name="code"/><field name="name"/><field name="purpose" widget="badge"/><field name="company_id" groups="base.group_multi_company"/><field name="version_count"/><field name="active"/></list></field></record>
    <record id="view_hierarchy_form" model="ir.ui.view"><field name="name">onehr.position.hierarchy.form.enterprise</field><field name="model">onehr.position.hierarchy</field><field name="arch" type="xml"><form string="Position Hierarchy"><sheet>
        <div class="oe_button_box" name="button_box"><button class="oe_stat_button" name="action_open_versions" type="object" icon="fa-code-fork"><field name="version_count" widget="statinfo" string="Versions"/></button></div>
        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/><field name="active" invisible="1"/><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
        <group><group><field name="code"/><field name="purpose"/></group><group><field name="company_id" groups="base.group_multi_company"/></group></group>
        <notebook><page string="Versions"><field name="version_ids"><list decoration-success="state == 'active'" decoration-muted="state == 'retired'"><field name="version"/><field name="valid_from"/><field name="valid_to"/><field name="node_count"/><field name="state" widget="badge"/></list></field></page></notebook>
    </sheet><chatter/></form></field></record>
    <record id="view_hierarchy_search" model="ir.ui.view"><field name="name">onehr.position.hierarchy.search.enterprise</field><field name="model">onehr.position.hierarchy</field><field name="arch" type="xml"><search><field name="code"/><field name="name"/><field name="purpose"/><field name="company_id"/><filter name="active_only" string="Active" domain="[('active', '=', True)]"/><filter name="archived" string="Archived" domain="[('active', '=', False)]"/><group><filter name="group_purpose" string="Purpose" context="{'group_by': 'purpose'}"/><filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/></group></search></field></record>
    <record id="action_hierarchies" model="ir.actions.act_window"><field name="name">Position Hierarchies</field><field name="res_model">onehr.position.hierarchy</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_hierarchy_search"/></record>

    <!-- Hierarchy Version -->
    <record id="view_hierarchy_version_list" model="ir.ui.view"><field name="name">onehr.position.hierarchy.version.list.enterprise</field><field name="model">onehr.position.hierarchy.version</field><field name="arch" type="xml"><list decoration-success="state == 'active'" decoration-muted="state == 'retired'"><field name="hierarchy_id"/><field name="version"/><field name="company_id" groups="base.group_multi_company"/><field name="valid_from"/><field name="valid_to"/><field name="node_count"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_hierarchy_version_form" model="ir.ui.view"><field name="name">onehr.position.hierarchy.version.form.enterprise</field><field name="model">onehr.position.hierarchy.version</field><field name="arch" type="xml"><form string="Hierarchy Version">
        <header><button name="action_activate" type="object" string="Activate" class="btn-primary" groups="hr.group_hr_manager" invisible="state != 'draft'"/><button name="action_retire" type="object" string="Retire" groups="hr.group_hr_manager" invisible="state != 'active'"/><field name="state" widget="statusbar" statusbar_visible="draft,active,retired"/></header>
        <sheet><div class="oe_button_box" name="button_box"><button class="oe_stat_button" name="action_open_nodes" type="object" icon="fa-sitemap"><field name="node_count" widget="statinfo" string="Nodes"/></button></div><div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
        <group><group string="Version Identity"><field name="hierarchy_id"/><field name="version"/><field name="company_id" groups="base.group_multi_company" readonly="1"/></group><group string="Business Validity"><field name="valid_from"/><field name="valid_to"/></group></group>
        <notebook><page string="Hierarchy Nodes"><field name="node_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="position_id"/><field name="parent_id" domain="[('version_id', '=', parent.id)]"/><button name="action_open_position" type="object" string="Open Position" icon="fa-external-link"/></list></field></page></notebook>
        </sheet><chatter/></form></field></record>
    <record id="view_hierarchy_version_search" model="ir.ui.view"><field name="name">onehr.position.hierarchy.version.search.enterprise</field><field name="model">onehr.position.hierarchy.version</field><field name="arch" type="xml"><search><field name="hierarchy_id"/><field name="version"/><field name="company_id"/><field name="state"/><filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/><filter name="active" string="Active" domain="[('state', '=', 'active')]"/><filter name="retired" string="Retired" domain="[('state', '=', 'retired')]"/><group><filter name="group_hierarchy" string="Hierarchy" context="{'group_by': 'hierarchy_id'}"/><filter name="group_state" string="State" context="{'group_by': 'state'}"/><filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/></group></search></field></record>
    <record id="action_hierarchy_versions" model="ir.actions.act_window"><field name="name">Hierarchy Versions</field><field name="res_model">onehr.position.hierarchy.version</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_hierarchy_version_search"/></record>

    <!-- Hierarchy Node -->
    <record id="view_hierarchy_node_list" model="ir.ui.view"><field name="name">onehr.position.hierarchy.node.list.enterprise</field><field name="model">onehr.position.hierarchy.node</field><field name="arch" type="xml"><list><field name="version_id"/><field name="sequence"/><field name="position_id"/><field name="parent_id"/><field name="company_id" groups="base.group_multi_company"/><button name="action_open_position" type="object" string="Position" icon="fa-external-link"/></list></field></record>
    <record id="view_hierarchy_node_form" model="ir.ui.view"><field name="name">onehr.position.hierarchy.node.form.enterprise</field><field name="model">onehr.position.hierarchy.node</field><field name="arch" type="xml"><form string="Hierarchy Node"><sheet>
        <div class="oe_button_box" name="button_box"><button class="oe_stat_button" name="action_open_position" type="object" icon="fa-briefcase"><div class="o_stat_info"><span class="o_stat_text">Open Position</span></div></button></div>
        <group><group string="Node"><field name="version_id"/><field name="position_id"/><field name="parent_id" domain="[('version_id', '=', version_id)]"/><field name="sequence"/></group><group string="Scope"><field name="company_id" groups="base.group_multi_company" readonly="1"/></group></group>
    </sheet><chatter/></form></field></record>
    <record id="view_hierarchy_node_search" model="ir.ui.view"><field name="name">onehr.position.hierarchy.node.search.enterprise</field><field name="model">onehr.position.hierarchy.node</field><field name="arch" type="xml"><search><field name="version_id"/><field name="position_id"/><field name="parent_id"/><field name="company_id"/><group><filter name="group_version" string="Version" context="{'group_by': 'version_id'}"/><filter name="group_parent" string="Parent" context="{'group_by': 'parent_id'}"/><filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/></group></search></field></record>
    <record id="action_hierarchy_nodes" model="ir.actions.act_window"><field name="name">Hierarchy Nodes</field><field name="res_model">onehr.position.hierarchy.node</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_hierarchy_node_search"/></record>
</odoo>
