<odoo>
    <!-- Sequence Rule -->
    <record id="view_sequence_rule_list" model="ir.ui.view"><field name="name">onehr.sequence.rule.list.enterprise</field><field name="model">onehr.sequence.rule</field><field name="arch" type="xml"><list decoration-muted="not active"><field name="code"/><field name="name"/><field name="sequence_id"/><field name="company_id" groups="base.group_multi_company"/><field name="valid_from"/><field name="valid_to"/><field name="active"/></list></field></record>
    <record id="view_sequence_rule_form" model="ir.ui.view"><field name="name">onehr.sequence.rule.form.enterprise</field><field name="model">onehr.sequence.rule</field><field name="arch" type="xml"><form string="Sequence Rule"><sheet><widget name="web_ribbon" title="Inactive" bg_color="text-bg-warning" invisible="active"/><field name="active" invisible="1"/><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group string="Business Rule"><field name="code"/><field name="sequence_id"/><field name="company_id" groups="base.group_multi_company"/></group><group string="Business Validity"><field name="valid_from"/><field name="valid_to"/></group></group><notebook><page string="Purpose"><field name="purpose"/></page></notebook></sheet><chatter/></form></field></record>
    <record id="view_sequence_rule_search" model="ir.ui.view"><field name="name">onehr.sequence.rule.search.enterprise</field><field name="model">onehr.sequence.rule</field><field name="arch" type="xml"><search><field name="code"/><field name="name"/><field name="sequence_id"/><field name="company_id"/><filter name="active_only" string="Active" domain="[('active', '=', True)]"/><filter name="inactive" string="Inactive" domain="[('active', '=', False)]"/><group><filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/></group></search></field></record>
    <record id="action_sequence_rules" model="ir.actions.act_window"><field name="name">Sequence Rules</field><field name="res_model">onehr.sequence.rule</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_sequence_rule_search"/></record>

    <!-- Eligibility Profile -->
    <record id="view_eligibility_list" model="ir.ui.view"><field name="name">onehr.eligibility.profile.list.enterprise</field><field name="model">onehr.eligibility.profile</field><field name="arch" type="xml"><list decoration-muted="not active"><field name="code"/><field name="name"/><field name="company_id" groups="base.group_multi_company"/><field name="min_service_months"/><field name="max_service_months"/><field name="valid_from"/><field name="valid_to"/><field name="active"/></list></field></record>
    <record id="view_eligibility_form" model="ir.ui.view"><field name="name">onehr.eligibility.profile.form.enterprise</field><field name="model">onehr.eligibility.profile</field><field name="arch" type="xml"><form string="Eligibility Profile"><sheet><widget name="web_ribbon" title="Inactive" bg_color="text-bg-warning" invisible="active"/><field name="active" invisible="1"/><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group string="Profile Identity"><field name="code"/><field name="company_id" groups="base.group_multi_company"/></group><group string="Business Validity"><field name="valid_from"/><field name="valid_to"/></group></group><notebook><page string="Organization Criteria"><group><field name="department_ids" widget="many2many_tags"/><field name="job_ids" widget="many2many_tags"/><field name="position_ids" widget="many2many_tags"/><field name="grade_ids" widget="many2many_tags"/><field name="work_location_ids" widget="many2many_tags"/></group></page><page string="Classification &amp; Service"><group><field name="classification_keys"/><field name="min_service_months"/><field name="max_service_months"/></group></page></notebook></sheet><chatter/></form></field></record>
    <record id="view_eligibility_search" model="ir.ui.view"><field name="name">onehr.eligibility.profile.search.enterprise</field><field name="model">onehr.eligibility.profile</field><field name="arch" type="xml"><search><field name="code"/><field name="name"/><field name="company_id"/><field name="department_ids"/><field name="job_ids"/><filter name="active_only" string="Active" domain="[('active', '=', True)]"/><filter name="inactive" string="Inactive" domain="[('active', '=', False)]"/><group><filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/></group></search></field></record>
    <record id="action_eligibility_profiles" model="ir.actions.act_window"><field name="name">Eligibility Profiles</field><field name="res_model">onehr.eligibility.profile</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_eligibility_search"/></record>

    <!-- Lifecycle Event Type -->
    <record id="view_lifecycle_type_list" model="ir.ui.view"><field name="name">onehr.lifecycle.event.type.list.enterprise</field><field name="model">onehr.lifecycle.event.type</field><field name="arch" type="xml"><list decoration-muted="not active"><field name="sequence" widget="handle"/><field name="code"/><field name="name"/><field name="checklist_template_count"/><field name="active"/></list></field></record>
    <record id="view_lifecycle_type_form" model="ir.ui.view"><field name="name">onehr.lifecycle.event.type.form.enterprise</field><field name="model">onehr.lifecycle.event.type</field><field name="arch" type="xml"><form string="Lifecycle Event Type"><sheet><div class="oe_button_box" name="button_box"><button class="oe_stat_button" name="action_open_checklist_templates" type="object" icon="fa-tasks"><field name="checklist_template_count" widget="statinfo" string="Checklist Templates"/></button></div><widget name="web_ribbon" title="Inactive" bg_color="text-bg-warning" invisible="active"/><field name="active" invisible="1"/><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><field name="code"/><field name="sequence"/></group></sheet><chatter/></form></field></record>
    <record id="view_lifecycle_type_search" model="ir.ui.view"><field name="name">onehr.lifecycle.event.type.search.enterprise</field><field name="model">onehr.lifecycle.event.type</field><field name="arch" type="xml"><search><field name="code"/><field name="name"/><filter name="active_only" string="Active" domain="[('active', '=', True)]"/><filter name="inactive" string="Inactive" domain="[('active', '=', False)]"/></search></field></record>
    <record id="action_lifecycle_event_types" model="ir.actions.act_window"><field name="name">Lifecycle Event Types</field><field name="res_model">onehr.lifecycle.event.type</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_lifecycle_type_search"/></record>
</odoo>
