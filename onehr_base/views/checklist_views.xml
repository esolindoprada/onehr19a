<odoo>
    <!-- Checklist Template -->
    <record id="view_checklist_template_list" model="ir.ui.view"><field name="name">onehr.checklist.template.list.enterprise</field><field name="model">onehr.checklist.template</field><field name="arch" type="xml"><list decoration-success="state == 'active'" decoration-muted="state == 'retired'"><field name="code"/><field name="name"/><field name="version"/><field name="lifecycle_event_type_id"/><field name="company_id" groups="base.group_multi_company"/><field name="task_template_count" string="Tasks"/><field name="instance_count" string="Allocated"/><field name="valid_from"/><field name="valid_to"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_checklist_template_form" model="ir.ui.view"><field name="name">onehr.checklist.template.form.enterprise</field><field name="model">onehr.checklist.template</field><field name="arch" type="xml"><form string="Checklist Template">
        <header><button name="action_activate" type="object" string="Activate" class="btn-primary" groups="hr.group_hr_manager" invisible="state != 'draft'"/><button name="action_retire" type="object" string="Retire" groups="hr.group_hr_manager" invisible="state != 'active'"/><button name="action_create_new_version" type="object" string="Create New Version" groups="hr.group_hr_manager"/><field name="state" widget="statusbar" statusbar_visible="draft,active,retired"/></header>
        <sheet><div class="oe_button_box" name="button_box"><button class="oe_stat_button" name="action_open_task_templates" type="object" icon="fa-list-ul"><field name="task_template_count" widget="statinfo" string="Task Definitions"/></button><button class="oe_stat_button" name="action_open_instances" type="object" icon="fa-check-square-o"><field name="instance_count" widget="statinfo" string="Allocated"/></button></div>
        <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group string="Template Identity"><field name="code"/><field name="version"/><field name="company_id" groups="base.group_multi_company"/></group><group string="Lifecycle &amp; Eligibility"><field name="lifecycle_event_type_id"/><field name="eligibility_profile_id"/></group></group><group string="Business Validity"><field name="valid_from"/><field name="valid_to"/></group>
        <notebook><page string="Task Definitions"><field name="task_template_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="due_offset_days"/><field name="evidence_required"/><field name="performer_policy"/><field name="performer_user_id" optional="show"/><field name="dependency_ids" widget="many2many_tags" optional="show"/><button name="action_open_template" type="object" string="Template" icon="fa-external-link"/></list></field></page></notebook>
        </sheet><chatter/></form></field></record>
    <record id="view_checklist_template_search" model="ir.ui.view"><field name="name">onehr.checklist.template.search.enterprise</field><field name="model">onehr.checklist.template</field><field name="arch" type="xml"><search><field name="code"/><field name="name"/><field name="lifecycle_event_type_id"/><field name="eligibility_profile_id"/><field name="company_id"/><field name="state"/><filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/><filter name="active" string="Active" domain="[('state', '=', 'active')]"/><filter name="retired" string="Retired" domain="[('state', '=', 'retired')]"/><group><filter name="group_event" string="Lifecycle Event" context="{'group_by': 'lifecycle_event_type_id'}"/><filter name="group_state" string="State" context="{'group_by': 'state'}"/><filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/></group></search></field></record>
    <record id="action_checklist_templates" model="ir.actions.act_window"><field name="name">Checklist Templates</field><field name="res_model">onehr.checklist.template</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_checklist_template_search"/></record>

    <!-- Task Definition -->
    <record id="view_task_template_list" model="ir.ui.view"><field name="name">onehr.checklist.task.template.list.enterprise</field><field name="model">onehr.checklist.task.template</field><field name="arch" type="xml"><list><field name="template_id"/><field name="sequence"/><field name="name"/><field name="due_offset_days"/><field name="evidence_required"/><field name="performer_policy"/><field name="performer_user_id" optional="show"/><field name="company_id" groups="base.group_multi_company"/><button name="action_open_template" type="object" string="Template" icon="fa-external-link"/></list></field></record>
    <record id="view_task_template_form" model="ir.ui.view"><field name="name">onehr.checklist.task.template.form.enterprise</field><field name="model">onehr.checklist.task.template</field><field name="arch" type="xml"><form string="Checklist Task Definition"><sheet>
        <div class="oe_button_box" name="button_box"><button class="oe_stat_button" name="action_open_template" type="object" icon="fa-tasks"><div class="o_stat_info"><span class="o_stat_text">Open Template</span></div></button></div><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
        <group><group string="Task Definition"><field name="template_id"/><field name="sequence"/><field name="due_offset_days"/><field name="evidence_required"/></group><group string="Performer"><field name="performer_policy"/><field name="performer_user_id" invisible="performer_policy != 'specific_user'"/><field name="company_id" groups="base.group_multi_company" readonly="1"/></group></group>
        <notebook><page string="Dependencies"><field name="dependency_ids" widget="many2many_tags" domain="[('template_id', '=', template_id)]"/></page><page string="Instructions"><field name="instructions"/></page></notebook>
    </sheet><chatter/></form></field></record>
    <record id="view_task_template_search" model="ir.ui.view"><field name="name">onehr.checklist.task.template.search.enterprise</field><field name="model">onehr.checklist.task.template</field><field name="arch" type="xml"><search><field name="template_id"/><field name="name"/><field name="performer_policy"/><field name="performer_user_id"/><field name="company_id"/><filter name="evidence_required" string="Evidence Required" domain="[('evidence_required', '=', True)]"/><group><filter name="group_template" string="Template" context="{'group_by': 'template_id'}"/><filter name="group_performer" string="Performer Policy" context="{'group_by': 'performer_policy'}"/><filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/></group></search></field></record>
    <record id="action_task_templates" model="ir.actions.act_window"><field name="name">Checklist Task Definitions</field><field name="res_model">onehr.checklist.task.template</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_task_template_search"/></record>

    <!-- Checklist Instance -->
    <record id="view_checklist_instance_list" model="ir.ui.view"><field name="name">onehr.checklist.instance.list.enterprise</field><field name="model">onehr.checklist.instance</field><field name="arch" type="xml"><list decoration-info="state == 'in_progress'" decoration-success="state == 'completed'" decoration-muted="state == 'cancelled'"><field name="name"/><field name="employee_id"/><field name="lifecycle_event_type_id"/><field name="template_code"/><field name="template_version"/><field name="event_date"/><field name="company_id" groups="base.group_multi_company"/><field name="task_count"/><field name="pending_task_count"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_checklist_instance_form" model="ir.ui.view"><field name="name">onehr.checklist.instance.form.enterprise</field><field name="model">onehr.checklist.instance</field><field name="arch" type="xml"><form string="Lifecycle Checklist">
        <header><button name="action_complete" type="object" string="Complete Checklist" class="btn-primary" invisible="state != 'in_progress'"/><button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft', 'in_progress')"/><field name="state" widget="statusbar" statusbar_visible="draft,in_progress,completed,cancelled"/></header>
        <sheet><div class="oe_button_box" name="button_box"><button class="oe_stat_button" name="action_open_tasks" type="object" icon="fa-tasks"><field name="task_count" widget="statinfo" string="Tasks"/></button><button class="oe_stat_button" name="action_open_tasks" type="object" icon="fa-hourglass-half"><field name="pending_task_count" widget="statinfo" string="Pending"/></button><button class="oe_stat_button" name="action_open_tasks" type="object" icon="fa-check"><field name="completed_task_count" widget="statinfo" string="Done"/></button></div>
        <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div><group><group string="Employee Event"><field name="employee_id" readonly="state == 'completed'"/><field name="company_id" groups="base.group_multi_company" readonly="state == 'completed'"/><field name="event_date" readonly="state == 'completed'"/><field name="lifecycle_event_type_id" readonly="1"/></group><group string="Frozen Template Version"><field name="template_id" readonly="state == 'completed'"/><field name="template_code" readonly="1"/><field name="template_name" readonly="1"/><field name="template_version" readonly="1"/></group></group>
        <!-- Body-form operational button; authorization still comes from server ACL/rules. -->
        <div class="d-flex gap-2 my-3" invisible="state != 'in_progress'"><button name="action_schedule_outstanding_activities" type="object" string="Schedule Outstanding Activities" class="btn-secondary" icon="fa-clock-o"/></div>
        <notebook><page string="Checklist Tasks"><field name="task_ids" readonly="state == 'completed'"><list decoration-success="state == 'done'" decoration-muted="state == 'cancelled'" decoration-warning="state == 'pending'"><field name="sequence"/><field name="name"/><field name="assigned_user_id"/><field name="due_date"/><field name="evidence_required"/><field name="state" widget="badge"/><button name="action_done" type="object" string="Done" icon="fa-check" invisible="state != 'pending'"/><button name="action_schedule_activity" type="object" string="Schedule" icon="fa-clock-o" invisible="state != 'pending' or not assigned_user_id or activity_id"/><button name="action_cancel" type="object" string="Cancel" icon="fa-times" invisible="state != 'pending'"/></list></field></page><page string="Source &amp; Completion"><group><group string="Source Reference"><field name="source_model" readonly="state == 'completed'"/><field name="source_res_id" readonly="state == 'completed'"/></group><group string="Completion Evidence"><field name="completed_at" readonly="1"/><field name="completed_by_id" readonly="1"/></group></group></page></notebook>
        </sheet><chatter/></form></field></record>
    <record id="view_checklist_instance_search" model="ir.ui.view"><field name="name">onehr.checklist.instance.search.enterprise</field><field name="model">onehr.checklist.instance</field><field name="arch" type="xml"><search><field name="name"/><field name="employee_id"/><field name="lifecycle_event_type_id"/><field name="template_code"/><field name="event_date"/><field name="company_id"/><field name="state"/><filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/><filter name="in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/><filter name="completed" string="Completed" domain="[('state', '=', 'completed')]"/><filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/><group><filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/><filter name="group_event" string="Lifecycle Event" context="{'group_by': 'lifecycle_event_type_id'}"/><filter name="group_state" string="State" context="{'group_by': 'state'}"/><filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/></group></search></field></record>
    <record id="action_checklist_instances" model="ir.actions.act_window"><field name="name">Checklist Instances</field><field name="res_model">onehr.checklist.instance</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_checklist_instance_search"/></record>

    <!-- Checklist Task -->
    <record id="view_checklist_task_list" model="ir.ui.view"><field name="name">onehr.checklist.task.list.enterprise</field><field name="model">onehr.checklist.task</field><field name="arch" type="xml"><list decoration-success="state == 'done'" decoration-muted="state == 'cancelled'" decoration-warning="state == 'pending'"><field name="instance_id"/><field name="employee_id"/><field name="sequence"/><field name="name"/><field name="assigned_user_id"/><field name="due_date"/><field name="evidence_required"/><field name="company_id" groups="base.group_multi_company"/><field name="state" widget="badge"/><button name="action_done" type="object" string="Done" icon="fa-check" invisible="state != 'pending'"/><button name="action_schedule_activity" type="object" string="Schedule" icon="fa-clock-o" invisible="state != 'pending' or not assigned_user_id or activity_id"/><button name="action_open_instance" type="object" string="Checklist" icon="fa-external-link"/></list></field></record>
    <record id="view_checklist_task_form" model="ir.ui.view"><field name="name">onehr.checklist.task.form.enterprise</field><field name="model">onehr.checklist.task</field><field name="arch" type="xml"><form string="Checklist Task">
        <header><button name="action_done" type="object" string="Mark Done" class="btn-primary" invisible="state != 'pending'"/><button name="action_cancel" type="object" string="Cancel" invisible="state != 'pending'"/><button name="action_schedule_activity" type="object" string="Schedule Activity" invisible="state != 'pending' or not assigned_user_id or activity_id"/><field name="state" widget="statusbar" statusbar_visible="pending,done,cancelled"/></header>
        <sheet><div class="oe_button_box" name="button_box"><button class="oe_stat_button" name="action_open_instance" type="object" icon="fa-check-square-o"><div class="o_stat_info"><span class="o_stat_text">Open Checklist</span></div></button></div><div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
        <group><group string="Assignment"><field name="instance_id" readonly="1"/><field name="employee_id" readonly="1"/><field name="assigned_user_id" readonly="state != 'pending'"/><field name="due_date" readonly="1"/><field name="company_id" groups="base.group_multi_company" readonly="1"/></group><group string="Governance"><field name="source_task_template_id" readonly="1"/><field name="performer_policy" readonly="1"/><field name="evidence_required" readonly="1"/><field name="dependency_ids" widget="many2many_tags" readonly="1"/><field name="activity_id" readonly="1"/></group></group>
        <notebook><page string="Instructions"><field name="instructions" readonly="1"/></page><page string="Completion Evidence"><group><field name="completion_note" readonly="state != 'pending'"/><field name="evidence_attachment_ids" widget="many2many_binary" readonly="state != 'pending'"/><field name="completed_at" readonly="1"/><field name="completed_by_id" readonly="1"/></group></page></notebook>
        </sheet><chatter/></form></field></record>
    <record id="view_checklist_task_search" model="ir.ui.view"><field name="name">onehr.checklist.task.search.enterprise</field><field name="model">onehr.checklist.task</field><field name="arch" type="xml"><search><field name="name"/><field name="instance_id"/><field name="employee_id"/><field name="assigned_user_id"/><field name="due_date"/><field name="company_id"/><field name="state"/><filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/><filter name="done" string="Done" domain="[('state', '=', 'done')]"/><filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/><filter name="evidence_required" string="Evidence Required" domain="[('evidence_required', '=', True)]"/><group><filter name="group_assignee" string="Assignee" context="{'group_by': 'assigned_user_id'}"/><filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/><filter name="group_state" string="State" context="{'group_by': 'state'}"/><filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/></group></search></field></record>
    <record id="action_checklist_tasks" model="ir.actions.act_window"><field name="name">Checklist Tasks</field><field name="res_model">onehr.checklist.task</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_checklist_task_search"/></record>
</odoo>
