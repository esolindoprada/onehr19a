<odoo>
    <!-- Master/configuration records are isolated to allowed companies. -->
    <record id="rule_job_family_company" model="ir.rule">
        <field name="name">OneHR Job Family — allowed companies</field>
        <field name="model_id" ref="model_onehr_job_family"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_position_company" model="ir.rule">
        <field name="name">OneHR Position — allowed companies</field>
        <field name="model_id" ref="model_onehr_position"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_hierarchy_company" model="ir.rule">
        <field name="name">OneHR Hierarchy — allowed companies</field>
