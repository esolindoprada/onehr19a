
<odoo>
    <!-- Native users: OneHR security management may only manage users whose
         default legal company is in the caller's allowed-company set. -->
    <record id="rule_res_users_onehr_security_company" model="ir.rule">
        <field name="name">Users — OneHR security allowed-company scope</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="groups" eval="[
            Command.link(ref('onehr_security.group_onehr_security_manager')),
            Command.link(ref('onehr_security.group_onehr_security_admin'))
        ]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Role catalog and SoD policy: global rows + caller's allowed companies. -->
    <record id="rule_onehr_role_company" model="ir.rule">
        <field name="name">OneHR Role — allowed companies/global</field>
        <field name="model_id" ref="model_onehr_role"/>
        <field name="groups" eval="[Command.link(ref('onehr_security.group_onehr_security_user'))]"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_onehr_sod_matrix_company" model="ir.rule">
        <field name="name">OneHR SoD Matrix — allowed companies/global</field>
        <field name="model_id" ref="model_onehr_sod_matrix"/>
        <field name="groups" eval="[Command.link(ref('onehr_security.group_onehr_security_user'))]"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Security User sees only own assignment/conflict evidence. -->
    <record id="rule_onehr_user_role_self" model="ir.rule">
        <field name="name">OneHR User Role — self</field>
        <field name="model_id" ref="model_onehr_user_role"/>
        <field name="groups" eval="[Command.link(ref('onehr_security.group_onehr_security_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>

    <record id="rule_onehr_conflict_self" model="ir.rule">
        <field name="name">OneHR SoD Conflict — self</field>
        <field name="model_id" ref="model_onehr_sod_conflict_log"/>
        <field name="groups" eval="[Command.link(ref('onehr_security.group_onehr_security_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>

    <!-- Manager/Admin/Compliance group rules union with the self rule. -->
    <record id="rule_onehr_user_role_company_manager" model="ir.rule">
        <field name="name">OneHR User Role — security management company scope</field>
        <field name="model_id" ref="model_onehr_user_role"/>
        <field name="groups" eval="[
            Command.link(ref('onehr_security.group_onehr_security_manager')),
            Command.link(ref('onehr_security.group_onehr_compliance_officer'))
        ]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_onehr_conflict_company_management" model="ir.rule">
        <field name="name">OneHR SoD Conflict — security/compliance company scope</field>
        <field name="model_id" ref="model_onehr_sod_conflict_log"/>
        <field name="groups" eval="[
            Command.link(ref('onehr_security.group_onehr_security_manager')),
            Command.link(ref('onehr_security.group_onehr_compliance_officer'))
        ]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_onehr_audit_company_management" model="ir.rule">
        <field name="name">OneHR Audit — security/compliance company scope</field>
        <field name="model_id" ref="model_onehr_audit_log"/>
        <field name="groups" eval="[
            Command.link(ref('onehr_security.group_onehr_security_manager')),
            Command.link(ref('onehr_security.group_onehr_compliance_officer'))
        ]"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
