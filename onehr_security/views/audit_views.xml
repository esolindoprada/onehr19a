<odoo>
    <record id="view_onehr_audit_log_list" model="ir.ui.view">
        <field name="name">onehr.audit.log.list.enterprise</field>
        <field name="model">onehr.audit.log</field>
        <field name="arch" type="xml">
            <list
                create="false"
                edit="false"
                delete="false"
                decoration-danger="severity == 'critical'"
                decoration-warning="severity == 'high'"
                decoration-muted="is_anonymized"
            >
                <field name="event_at"/>
                <field name="actor_user_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="action" widget="badge"/>
                <field name="severity" widget="badge"/>
                <field name="summary"/>
                <field name="model_name" optional="show"/>
                <field name="res_id" optional="show"/>
                <field name="correlation_id" optional="hide"/>
                <field name="is_anonymized" optional="hide"/>
                <button name="action_open_target" type="object" string="Target" icon="fa-external-link" invisible="not model_name or not res_id"/>
            </list>
        </field>
    </record>

    <record id="view_onehr_audit_log_form" model="ir.ui.view">
        <field name="name">onehr.audit.log.form.enterprise</field>
        <field name="model">onehr.audit.log</field>
        <field name="arch" type="xml">
            <form string="Security Audit Evidence" create="false" edit="false" delete="false">
                <header>
                    <button
                        name="action_anonymize_payload"
                        type="object"
                        string="Anonymize Payload"
                        groups="onehr_security.group_onehr_security_admin,onehr_security.group_onehr_compliance_officer"
                        invisible="is_anonymized"
                    />
                </header>

                <sheet>
                    <widget name="web_ribbon" title="Anonymized" bg_color="text-bg-secondary" invisible="not is_anonymized"/>

                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_open_target"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-external-link"
                            invisible="not model_name or not res_id"
                        >
                            <div class="o_stat_info"><span class="o_stat_text">Open Target</span></div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1><field name="summary" readonly="1"/></h1>
                    </div>

                    <group>
                        <group string="Event">
                            <field name="event_at" readonly="1"/>
                            <field name="actor_user_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="action" widget="badge" readonly="1"/>
                            <field name="severity" widget="badge" readonly="1"/>
                        </group>
                        <group string="Target / Correlation">
                            <field name="model_name" readonly="1"/>
                            <field name="res_id" readonly="1"/>
                            <field name="role_id" readonly="1"/>
                            <field name="user_role_id" readonly="1"/>
                            <field name="correlation_id" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Change Evidence" name="change_evidence">
                            <group>
                                <field name="changed_fields" readonly="1"/>
                                <field name="before_json" readonly="1"/>
                                <field name="after_json" readonly="1"/>
                            </group>
                        </page>
                        <page string="Metadata" name="metadata">
                            <field name="metadata_json" readonly="1"/>
                        </page>
                        <page string="Retention Evidence" name="retention">
                            <group>
                                <field name="is_anonymized" readonly="1"/>
                                <field name="anonymized_at" readonly="1"/>
                                <field name="anonymized_by_id" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_onehr_audit_log_search" model="ir.ui.view">
        <field name="name">onehr.audit.log.search.enterprise</field>
        <field name="model">onehr.audit.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="summary"/>
                <field name="actor_user_id"/>
                <field name="company_id"/>
                <field name="action"/>
                <field name="severity"/>
                <field name="model_name"/>
                <field name="correlation_id"/>
                <field name="event_at"/>
                <filter name="high_risk" string="High / Critical" domain="[('severity', 'in', ('high', 'critical'))]"/>
                <filter name="sod" string="SoD Events" domain="[('action', 'in', ('sod_detect', 'sod_resolve'))]"/>
                <filter name="reconcile" string="Access Reconciliation" domain="[('action', '=', 'reconcile')]"/>
                <filter name="anonymized" string="Anonymized" domain="[('is_anonymized', '=', True)]"/>
                <group>
                    <filter name="group_actor" string="Actor" context="{'group_by': 'actor_user_id'}"/>
                    <filter name="group_action" string="Action" context="{'group_by': 'action'}"/>
                    <filter name="group_severity" string="Severity" context="{'group_by': 'severity'}"/>
                    <filter name="group_model" string="Target Model" context="{'group_by': 'model_name'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_onehr_audit_logs" model="ir.actions.act_window">
        <field name="name">Security Audit</field>
        <field name="res_model">onehr.audit.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_onehr_audit_log_search"/>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>
</odoo>
