<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_onehr_timeoff" model="ir.module.category">
        <field name="name">OneHR Time Off</field>
        <field name="description">Leave self-service, team approval and HR entitlement administration.</field>
        <field name="sequence">40</field>
    </record>

    <record id="privilege_onehr_timeoff" model="res.groups.privilege">
        <field name="name">OneHR Time Off</field>
        <field name="description">Leave request, line-manager review and HR policy/entitlement privileges.</field>
        <field name="category_id" ref="module_category_onehr_timeoff"/>
        <field name="sequence">40</field>
    </record>

    <record id="group_onehr_timeoff_user" model="res.groups">
        <field name="name">Time Off User</field>
        <field name="privilege_id" ref="privilege_onehr_timeoff"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[
            Command.link(ref('onehr_security.group_onehr_security_user')),
            Command.link(ref('onehr_workflow_approval.group_onehr_approval_user'))
        ]"/>
        <field name="comment">Employee self-service role. Own requests and own balances only; no private HR master access.</field>
    </record>

    <record id="group_onehr_timeoff_manager" model="res.groups">
        <field name="name">Time Off Manager</field>
        <field name="privilege_id" ref="privilege_onehr_timeoff"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[
            Command.link(ref('onehr_timeoff.group_onehr_timeoff_user')),
            Command.link(ref('onehr_workflow_approval.group_onehr_approver'))
        ]"/>
        <field name="comment">Line-manager visibility for direct-report leave and team calendar. Does not grant broad Core HR private-data access.</field>
    </record>

    <record id="group_onehr_timeoff_hr" model="res.groups">
        <field name="name">Time Off HR</field>
        <field name="privilege_id" ref="privilege_onehr_timeoff"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[
            Command.link(ref('onehr_timeoff.group_onehr_timeoff_manager')),
            Command.link(ref('onehr_corehr.group_onehr_corehr_officer'))
        ]"/>
        <field name="comment">Administers leave policies, allocations, accrual/carry-over and governed corrections within allowed companies.</field>
    </record>
</odoo>
