<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_onehr_leave_request" model="ir.sequence">
        <field name="name">OneHR Leave Request</field>
        <field name="code">onehr.leave.request</field>
        <field name="prefix">LVR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_onehr_leave_allocation" model="ir.sequence">
        <field name="name">OneHR Leave Allocation</field>
        <field name="code">onehr.leave.allocation</field>
        <field name="prefix">LVA/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
