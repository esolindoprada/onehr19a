<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_onehr_attendance_import_batch" model="ir.sequence">
        <field name="name">OneHR Attendance Import Batch</field>
        <field name="code">onehr.attendance.import.batch</field>
        <field name="prefix">ATI/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_onehr_attendance_reconciliation" model="ir.sequence">
        <field name="name">OneHR Attendance Reconciliation</field>
        <field name="code">onehr.attendance.reconciliation</field>
        <field name="prefix">ATR/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
