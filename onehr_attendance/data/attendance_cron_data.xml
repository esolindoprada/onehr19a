<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_onehr_shift_schedule_state" model="ir.cron">
        <field name="name">OneHR Attendance — Refresh Shift Schedule States</field>
        <field name="model_id" ref="model_onehr_shift_assignment"/>
        <field name="state">code</field>
        <field name="code">model._cron_refresh_state()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_onehr_attendance_missing_punch" model="ir.cron">
        <field name="name">OneHR Attendance — Detect Prior-Day Missing Punches</field>
        <field name="model_id" ref="model_onehr_shift_assignment"/>
        <field name="state">code</field>
        <field name="code">model._cron_detect_missing_punches()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
