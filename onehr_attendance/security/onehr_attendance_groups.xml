<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_onehr_attendance" model="ir.module.category">
        <field name="name">OneHR Attendance</field>
        <field name="description">Shift scheduling, attendance reconciliation, exception and import governance.</field>
        <field name="sequence">39</field>
    </record>

    <record id="privilege_onehr_attendance" model="res.groups.privilege">
        <field name="name">OneHR Attendance</field>
        <field name="description">Operational attendance and attendance policy authority.</field>
        <field name="category_id" ref="module_category_onehr_attendance"/>
        <field name="sequence">39</field>
    </record>

    <record id="group_onehr_attendance_officer" model="res.groups">
        <field name="name">Attendance Officer</field>
        <field name="privilege_id" ref="privilege_onehr_attendance"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[
            Command.link(ref('onehr_security.group_onehr_security_user')),
            Command.link(ref('hr_attendance.group_hr_attendance_user'))
        ]"/>
        <field name="comment">Operates company-scoped attendance, imports, reconciliation and exception handling. Shift-policy activation and final posting remain manager authority.</field>
    </record>

    <record id="group_onehr_attendance_manager" model="res.groups">
        <field name="name">Attendance Manager</field>
        <field name="privilege_id" ref="privilege_onehr_attendance"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[
            Command.link(ref('onehr_attendance.group_onehr_attendance_officer')),
            Command.link(ref('hr_attendance.group_hr_attendance_manager'))
        ]"/>
        <field name="comment">Attendance policy administrator. Activates shifts/patterns/schedules, approves reconciliation and posts governed attendance evidence.</field>
    </record>
</odoo>
