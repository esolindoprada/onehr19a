<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_onehr_kiosk_device" model="ir.sequence">
        <field name="name">OneHR Kiosk Device</field>
        <field name="code">onehr.kiosk.device</field>
        <field name="prefix">KSK/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_onehr_kiosk_log" model="ir.sequence">
        <field name="name">OneHR Kiosk Activity Log</field>
        <field name="code">onehr.kiosk.log</field>
        <field name="prefix">KLG/%(year)s/</field>
        <field name="padding">7</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
