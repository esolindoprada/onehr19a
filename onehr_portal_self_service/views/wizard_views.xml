
<odoo>
    <record id="view_onehr_portal_request_decision_wizard_form" model="ir.ui.view">
        <field name="name">onehr.portal.request.decision.wizard.form</field>
        <field name="model">onehr.portal.request.decision.wizard</field>
        <field name="arch" type="xml">
            <form string="Request Decision">
                <group>
                    <field name="request_id"/>
                    <field name="decision" widget="radio"/>
                    <field name="note" placeholder="Decision rationale; mandatory for rejection."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm Decision" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_onehr_portal_bulk_approval_wizard_form" model="ir.ui.view">
        <field name="name">onehr.portal.bulk.approval.wizard.form</field>
        <field name="model">onehr.portal.bulk.approval.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Request Decision">
                <group>
                    <field name="request_count"/>
                    <field name="decision" widget="radio"/>
                    <field name="note" placeholder="Shared decision note; mandatory for rejection."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Process Selected Requests" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_onehr_portal_bulk_approval_wizard" model="ir.actions.act_window">
        <field name="name">Bulk Request Decision</field>
        <field name="res_model">onehr.portal.bulk.approval.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_onehr_portal_request"/>
        <field name="binding_type">action</field>
        <field name="group_ids" eval="[
            Command.link(ref('onehr_portal_self_service.group_onehr_portal_manager')),
            Command.link(ref('onehr_portal_self_service.group_onehr_portal_hr'))
        ]"/>
    </record>
</odoo>

