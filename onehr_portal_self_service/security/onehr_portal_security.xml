
<odoo>
    <record id="module_category_onehr_portal" model="ir.module.category">
        <field name="name">OneHR Portal Self-Service</field>
        <field name="description">Employee/manager self-service and HR service request governance.</field>
        <field name="sequence">72</field>
    </record>

    <record id="privilege_onehr_portal" model="res.groups.privilege">
        <field name="name">OneHR Portal Self-Service</field>
        <field name="description">Self-service request and HR service delivery privileges.</field>
        <field name="category_id" ref="module_category_onehr_portal"/>
        <field name="sequence">72</field>
    </record>

    <record id="group_onehr_portal_employee" model="res.groups">
        <field name="name">Portal Employee</field>
        <field name="privilege_id" ref="privilege_onehr_portal"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="comment">Authenticated employee self-service: own requests only.</field>
    </record>

    <record id="group_onehr_portal_manager" model="res.groups">
        <field name="name">Portal Manager</field>
        <field name="privilege_id" ref="privilege_onehr_portal"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[Command.link(ref('onehr_portal_self_service.group_onehr_portal_employee'))]"/>
        <field name="comment">Direct-manager queue and governed manager decision authority.</field>
    </record>

    <record id="group_onehr_portal_hr" model="res.groups">
        <field name="name">Portal HR Officer</field>
        <field name="privilege_id" ref="privilege_onehr_portal"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[
            Command.link(ref('hr.group_hr_user')),
            Command.link(ref('onehr_security.group_onehr_security_user'))
        ]"/>
        <field name="comment">Company-scoped HR service processing, final decisions and downstream hand-off.</field>
    </record>

    <record id="group_onehr_portal_admin" model="res.groups">
        <field name="name">Portal HR Manager</field>
        <field name="privilege_id" ref="privilege_onehr_portal"/>
        <field name="sequence">40</field>
        <field name="implied_ids" eval="[
            Command.link(ref('onehr_portal_self_service.group_onehr_portal_hr')),
            Command.link(ref('hr.group_hr_manager'))
        ]"/>
        <field name="comment">Highest Portal Self-Service configuration and controlled Draft deletion authority.</field>
    </record>
</odoo>

