
<odoo>
    <!-- Global company boundaries always AND with role-specific request rules. -->
    <record id="rule_portal_request_company" model="ir.rule">
        <field name="name">Portal Request — company boundary</field>
        <field name="model_id" ref="model_onehr_portal_request"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_portal_request_type_company" model="ir.rule">
        <field name="name">Portal Request Type — company/shared boundary</field>
        <field name="model_id" ref="model_onehr_portal_request_type"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_portal_request_stage_company" model="ir.rule">
        <field name="name">Portal Request Stage — company/shared boundary</field>
        <field name="model_id" ref="model_onehr_portal_request_stage"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_portal_request_employee_scope" model="ir.rule">
        <field name="name">Portal Request — employee self scope</field>
        <field name="model_id" ref="model_onehr_portal_request"/>
        <field name="groups" eval="[Command.link(ref('onehr_portal_self_service.group_onehr_portal_employee'))]"/>
        <field name="domain_force">[('employee_user_id', '=', user.id)]</field>
    </record>

    <record id="rule_portal_request_manager_scope" model="ir.rule">
        <field name="name">Portal Request — direct manager scope</field>
        <field name="model_id" ref="model_onehr_portal_request"/>
        <field name="groups" eval="[Command.link(ref('onehr_portal_self_service.group_onehr_portal_manager'))]"/>
        <field name="domain_force">[('manager_user_id', '=', user.id)]</field>
    </record>

    <record id="rule_portal_request_hr_scope" model="ir.rule">
        <field name="name">Portal Request — HR company scope</field>
        <field name="model_id" ref="model_onehr_portal_request"/>
        <field name="groups" eval="[Command.link(ref('onehr_portal_self_service.group_onehr_portal_hr'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>

