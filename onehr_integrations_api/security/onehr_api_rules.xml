<odoo>
    <record id="rule_onehr_api_key_company" model="ir.rule">
        <field name="name">API Key — company boundary</field>
        <field name="model_id" ref="model_onehr_api_key"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_onehr_webhook_company" model="ir.rule">
        <field name="name">Webhook — company boundary</field>
        <field name="model_id" ref="model_onehr_webhook"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_onehr_api_log_company" model="ir.rule">
        <field name="name">API Log — company boundary</field>
        <field name="model_id" ref="model_onehr_api_log"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_onehr_api_queue_company" model="ir.rule">
        <field name="name">API Queue — company boundary</field>
        <field name="model_id" ref="model_onehr_api_queue"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
