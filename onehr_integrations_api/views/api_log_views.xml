<odoo>
    <record id="view_onehr_api_log_list" model="ir.ui.view">
        <field name="name">onehr.api.log.list</field><field name="model">onehr.api.log</field>
        <field name="arch" type="xml">
            <list string="API Audit Logs" create="0" edit="0" delete="0" decoration-success="outcome == 'success'" decoration-danger="outcome in ('server_error','auth_error')" decoration-warning="outcome in ('client_error','forbidden','rate_limited')" decoration-muted="archived">
                <field name="event_at"/><field name="direction" widget="badge"/><field name="request_id" optional="show"/><field name="api_key_id" optional="show"/><field name="webhook_id" optional="show"/><field name="scope_code"/><field name="method" widget="badge"/><field name="path"/><field name="http_status"/><field name="outcome" widget="badge"/><field name="latency_ms"/><field name="company_id" groups="base.group_multi_company"/><field name="archived" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_onehr_api_log_form" model="ir.ui.view">
        <field name="name">onehr.api.log.form</field><field name="model">onehr.api.log</field>
        <field name="arch" type="xml">
            <form string="API Audit Log" create="0" edit="0" delete="0">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-secondary" invisible="not archived"/>
                    <div class="oe_title"><h1><field name="request_id"/></h1><div class="text-muted"><field name="event_at"/> · <field name="outcome" widget="badge"/></div></div>
                    <group>
                        <group string="Request"><field name="direction"/><field name="company_id"/><field name="api_key_id"/><field name="webhook_id"/><field name="service_user_id"/><field name="scope_code"/><field name="method"/><field name="path"/></group>
                        <group string="Result"><field name="http_status"/><field name="outcome"/><field name="latency_ms"/><field name="remote_ip"/><field name="user_agent"/><field name="queue_id"/><field name="archived"/></group>
                    </group>
                    <notebook>
                        <page string="Integrity Hashes"><group><field name="request_hash"/><field name="response_hash"/></group></page>
                        <page string="Sanitized Payload" groups="onehr_integrations_api.group_onehr_api_admin"><group><field name="request_payload" nolabel="1"/><field name="response_payload" nolabel="1"/></group></page>
                        <page string="Error"><group><field name="error_class"/><field name="error_message" nolabel="1"/></group></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_onehr_api_log_search" model="ir.ui.view">
        <field name="name">onehr.api.log.search</field><field name="model">onehr.api.log</field>
        <field name="arch" type="xml"><search string="API Audit Logs"><field name="request_id"/><field name="api_key_id"/><field name="webhook_id"/><field name="scope_code"/><field name="path"/><field name="error_class"/><filter name="success" string="Success" domain="[('outcome','=','success')]"/><filter name="errors" string="Errors" domain="[('outcome','!=','success')]"/><filter name="server_errors" string="Server Errors" domain="[('outcome','=','server_error')]"/><filter name="rate_limited" string="Rate Limited" domain="[('outcome','=','rate_limited')]"/><filter name="not_archived" string="Operational" domain="[('archived','=',False)]"/><group><filter name="group_company" string="Company" context="{'group_by':'company_id'}" groups="base.group_multi_company"/><filter name="group_direction" string="Direction" context="{'group_by':'direction'}"/><filter name="group_scope" string="Scope/Event" context="{'group_by':'scope_code'}"/><filter name="group_outcome" string="Outcome" context="{'group_by':'outcome'}"/></group></search></field>
    </record>

    <record id="view_onehr_api_log_pivot" model="ir.ui.view"><field name="name">onehr.api.log.pivot</field><field name="model">onehr.api.log</field><field name="arch" type="xml"><pivot string="API KPI"><field name="company_id" type="row"/><field name="scope_code" type="row"/><field name="outcome" type="col"/><field name="latency_ms" type="measure"/></pivot></field></record>
    <record id="view_onehr_api_log_graph" model="ir.ui.view"><field name="name">onehr.api.log.graph</field><field name="model">onehr.api.log</field><field name="arch" type="xml"><graph string="API KPI"><field name="event_at" interval="day"/><field name="outcome"/><field name="latency_ms" type="measure"/></graph></field></record>

    <record id="action_onehr_api_logs" model="ir.actions.act_window"><field name="name">API Audit Logs</field><field name="res_model">onehr.api.log</field><field name="view_mode">list,pivot,graph,form</field><field name="search_view_id" ref="view_onehr_api_log_search"/><field name="group_ids" eval="[Command.link(ref('onehr_integrations_api.group_onehr_api_user'))]"/></record>
</odoo>
