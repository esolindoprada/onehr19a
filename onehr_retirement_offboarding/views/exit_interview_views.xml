<odoo>
    <record id="view_onehr_exit_interview_list" model="ir.ui.view">
        <field name="name">onehr.exit.interview.list.enterprise</field>
        <field name="model">onehr.exit.interview</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'submitted'" decoration-muted="state == 'waived'">
                <field name="offboarding_id"/>
                <field name="employee_id"/>
                <field name="interviewer_user_id"/>
                <field name="scheduled_at"/>
                <field name="primary_exit_reason" widget="badge"/>
                <field name="overall_score"/>
                <field name="recommendation_score" optional="show"/>
                <field name="state" widget="badge"/>
                <button name="action_start" type="object" string="Start" icon="fa-play" invisible="state not in ('draft', 'scheduled')"/>
                <button name="action_submit" type="object" string="Submit" icon="fa-check" invisible="state not in ('in_progress', 'scheduled')"/>
                <button name="action_reopen" type="object" string="Reopen" icon="fa-undo" groups="onehr_retirement_offboarding.group_onehr_offboarding_manager" invisible="state not in ('submitted', 'waived')"/>
            </list>
        </field>
    </record>

    <record id="view_onehr_exit_interview_form" model="ir.ui.view">
        <field name="name">onehr.exit.interview.form.enterprise</field>
        <field name="model">onehr.exit.interview</field>
        <field name="arch" type="xml">
            <form string="Exit Interview">
                <header>
                    <button name="action_schedule" type="object" string="Schedule" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start" type="object" string="Start" class="btn-primary" invisible="state not in ('draft', 'scheduled')"/>
                    <button name="action_submit" type="object" string="Submit Interview" class="btn-primary" invisible="state not in ('in_progress', 'scheduled')"/>
                    <button name="action_waive" type="object" string="Waive" groups="onehr_retirement_offboarding.group_onehr_offboarding_manager" invisible="state in ('submitted', 'waived')"/>
                    <button name="action_reopen" type="object" string="Reopen" groups="onehr_retirement_offboarding.group_onehr_offboarding_manager" invisible="state not in ('submitted', 'waived')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,in_progress,submitted,waived"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Submitted" bg_color="text-bg-success" invisible="state != 'submitted'"/>
                    <widget name="web_ribbon" title="Waived" bg_color="text-bg-secondary" invisible="state != 'waived'"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_offboarding" type="object" class="oe_stat_button" icon="fa-sign-out">
                            <div class="o_stat_info"><span class="o_stat_text">Offboarding Case</span></div>
                        </button>
                    </div>
                    <div class="oe_title"><h1>Exit Interview — <field name="employee_id" readonly="1"/></h1></div>
                    <group>
                        <group string="Schedule">
                            <field name="offboarding_id" readonly="1"/>
                            <field name="interviewer_user_id"/>
                            <field name="scheduled_at"/>
                        </group>
                        <group string="Exit Context">
                            <field name="primary_exit_reason"/>
                            <field name="destination_category"/>
                            <field name="overall_score" readonly="1"/>
                            <field name="recommendation_score"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Experience Scores">
                            <group>
                                <group>
                                    <field name="manager_relationship_score"/>
                                    <field name="role_clarity_score"/>
                                    <field name="rewards_score"/>
                                </group>
                                <group>
                                    <field name="culture_score"/>
                                    <field name="growth_score"/>
                                    <field name="work_life_score"/>
                                </group>
                            </group>
                        </page>
                        <page string="Employee Feedback">
                            <group>
                                <field name="reason_detail"/>
                                <field name="employee_feedback"/>
                                <field name="improvement_suggestions"/>
                            </group>
                        </page>
                        <page string="Confidential HR" groups="onehr_retirement_offboarding.group_onehr_offboarding_manager">
                            <field name="confidential_hr_notes"/>
                        </page>
                        <page string="Submission Evidence">
                            <group>
                                <field name="submitted_at" readonly="1"/>
                                <field name="submitted_by_id" readonly="1"/>
                                <field name="waiver_reason" readonly="state == 'waived'"/>
                                <field name="waived_at" readonly="1"/>
                                <field name="waived_by_id" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_onehr_exit_interview_search" model="ir.ui.view">
        <field name="name">onehr.exit.interview.search.enterprise</field>
        <field name="model">onehr.exit.interview</field>
        <field name="arch" type="xml">
            <search string="Exit Interviews">
                <field name="offboarding_id"/>
                <field name="employee_id"/>
                <field name="interviewer_user_id"/>
                <field name="primary_exit_reason"/>
                <field name="scheduled_at"/>
                <filter name="submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
                <filter name="open" string="Open" domain="[('state', 'not in', ('submitted', 'waived'))]"/>
                <group>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Exit Reason" name="group_reason" context="{'group_by': 'primary_exit_reason'}"/>
                    <filter string="Interviewer" name="group_interviewer" context="{'group_by': 'interviewer_user_id'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_onehr_exit_interview_pivot" model="ir.ui.view">
        <field name="name">onehr.exit.interview.pivot.analytics</field>
        <field name="model">onehr.exit.interview</field>
        <field name="arch" type="xml">
            <pivot string="Exit Interview Analytics">
                <field name="primary_exit_reason" type="row"/>
                <field name="company_id" type="col"/>
                <field name="overall_score" type="measure"/>
                <field name="recommendation_score" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_onehr_exit_interview_graph" model="ir.ui.view">
        <field name="name">onehr.exit.interview.graph.analytics</field>
        <field name="model">onehr.exit.interview</field>
        <field name="arch" type="xml">
            <graph string="Exit Reason Distribution" type="bar">
                <field name="primary_exit_reason"/>
                <field name="id" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_onehr_exit_interview" model="ir.actions.act_window">
        <field name="name">Exit Interviews</field>
        <field name="res_model">onehr.exit.interview</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_onehr_exit_interview_search"/>
        <field name="group_ids" eval="[Command.link(ref('onehr_retirement_offboarding.group_onehr_offboarding_officer'))]"/>
    </record>
</odoo>
