<odoo>
    <record id="view_hr_employee_form_onehr_offboarding" model="ir.ui.view">
        <field name="name">hr.employee.form.onehr.offboarding</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_onehr_offboarding"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-sign-out"
                        groups="onehr_retirement_offboarding.group_onehr_offboarding_officer">
                    <field name="onehr_offboarding_count" widget="statinfo" string="Offboarding"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
