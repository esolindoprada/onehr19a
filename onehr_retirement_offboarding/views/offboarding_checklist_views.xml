<odoo>
    <record id="view_onehr_offboarding_checklist_list" model="ir.ui.view">
        <field name="name">onehr.offboarding.checklist.list.enterprise</field>
        <field name="model">onehr.offboarding.checklist</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" decoration-success="state == 'done'" decoration-muted="state == 'waived'">
                <field name="offboarding_id"/>
                <field name="employee_id"/>
                <field name="item_code"/>
                <field name="title"/>
                <field name="category" widget="badge"/>
                <field name="owner_role" widget="badge"/>
                <field name="assigned_user_id"/>
                <field name="due_date"/>
                <field name="mandatory" optional="show"/>
                <field name="return_status" widget="badge" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="is_overdue" column_invisible="True"/>
                <button name="action_assign_to_me" type="object" string="Mine" icon="fa-user" invisible="state in ('done', 'waived')"/>
                <button name="action_start" type="object" string="Start" icon="fa-play" invisible="state not in ('pending', 'blocked')"/>
                <button name="action_complete" type="object" string="Complete" icon="fa-check" invisible="state in ('done', 'waived')"/>
                <button name="action_reopen" type="object" string="Reopen" icon="fa-undo" groups="onehr_retirement_offboarding.group_onehr_offboarding_manager" invisible="state not in ('done', 'waived')"/>
            </list>
        </field>
    </record>

    <record id="view_onehr_offboarding_checklist_kanban" model="ir.ui.view">
        <field name="name">onehr.offboarding.checklist.kanban.enterprise</field>
        <field name="model">onehr.offboarding.checklist</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="offboarding_id"/>
                <field name="employee_id"/>
                <field name="title"/>
                <field name="category"/>
                <field name="assigned_user_id"/>
                <field name="due_date"/>
                <field name="state"/>
                <field name="is_overdue"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start">
                            <strong><field name="title"/></strong>
                            <field name="category" widget="badge"/>
                        </div>
                        <div class="text-muted mt-1"><field name="offboarding_id"/> · <field name="employee_id"/></div>
                        <div class="mt-2">Owner: <field name="assigned_user_id"/></div>
                        <div>Due: <field name="due_date"/></div>
                        <div class="mt-2"><field name="state" widget="badge"/></div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_onehr_offboarding_checklist_form" model="ir.ui.view">
        <field name="name">onehr.offboarding.checklist.form.enterprise</field>
        <field name="model">onehr.offboarding.checklist</field>
        <field name="arch" type="xml">
            <form string="Offboarding Clearance Task">
                <header>
                    <button name="action_assign_to_me" type="object" string="Assign to Me" class="btn-secondary" invisible="state in ('done', 'waived')"/>
                    <button name="action_start" type="object" string="Start" class="btn-primary" invisible="state not in ('pending', 'blocked')"/>
                    <button name="action_complete" type="object" string="Complete" class="btn-primary" invisible="state in ('done', 'waived')"/>
                    <button name="action_block" type="object" string="Block" invisible="state in ('done', 'waived', 'blocked')"/>
                    <button name="action_waive" type="object" string="Waive" groups="onehr_retirement_offboarding.group_onehr_offboarding_manager" invisible="state in ('done', 'waived')"/>
                    <button name="action_reopen" type="object" string="Reopen" groups="onehr_retirement_offboarding.group_onehr_offboarding_manager" invisible="state not in ('done', 'waived')"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,in_progress,blocked,done,waived"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Overdue" bg_color="text-bg-danger" invisible="not is_overdue"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_offboarding" type="object" class="oe_stat_button" icon="fa-sign-out">
                            <div class="o_stat_info"><span class="o_stat_text">Offboarding Case</span></div>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="title" readonly="1"/></h1><div class="text-muted"><field name="item_code" readonly="1"/></div></div>
                    <group>
                        <group string="Assignment &amp; SLA">
                            <field name="offboarding_id" readonly="1"/>
                            <field name="employee_id" readonly="1"/>
                            <field name="assigned_user_id"/>
                            <field name="due_date"/>
                            <field name="mandatory" readonly="1"/>
                        </group>
                        <group string="Clearance Context">
                            <field name="category" readonly="1" widget="badge"/>
                            <field name="owner_role" readonly="1" widget="badge"/>
                            <field name="asset_reference"/>
                            <field name="return_status"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Work &amp; Evidence">
                            <group>
                                <field name="instructions" readonly="1"/>
                                <field name="completion_note"/>
                                <field name="evidence_attachment_ids" widget="many2many_binary"/>
                            </group>
                        </page>
                        <page string="Exception Handling">
                            <group>
                                <field name="block_reason"/>
                                <field name="waiver_reason" readonly="state == 'waived'"/>
                                <field name="waived_by_id" readonly="1"/>
                                <field name="waived_at" readonly="1"/>
                            </group>
                        </page>
                        <page string="Completion Evidence">
                            <group>
                                <field name="started_at" readonly="1"/>
                                <field name="completed_at" readonly="1"/>
                                <field name="completed_by_id" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                    <field name="is_overdue" invisible="1"/>
                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_onehr_offboarding_checklist_search" model="ir.ui.view">
        <field name="name">onehr.offboarding.checklist.search.enterprise</field>
        <field name="model">onehr.offboarding.checklist</field>
        <field name="arch" type="xml">
            <search string="Offboarding Clearance Tasks">
                <field name="offboarding_id"/>
                <field name="employee_id"/>
                <field name="title"/>
                <field name="item_code"/>
                <field name="assigned_user_id"/>
                <field name="category"/>
                <field name="owner_role"/>
                <field name="due_date"/>
                <filter name="open" string="Open" domain="[('state', 'not in', ('done', 'waived'))]"/>
                <filter name="my_tasks" string="My Tasks" domain="[('assigned_user_id', '=', uid)]"/>
                <filter name="mandatory" string="Mandatory" domain="[('mandatory', '=', True)]"/>
                <group>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Owner" name="group_owner" context="{'group_by': 'assigned_user_id'}"/>
                    <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
                    <filter string="Case" name="group_case" context="{'group_by': 'offboarding_id'}"/>
                    <filter string="Due Date" name="group_due" context="{'group_by': 'due_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_onehr_offboarding_checklist_calendar" model="ir.ui.view">
        <field name="name">onehr.offboarding.checklist.calendar.sla</field>
        <field name="model">onehr.offboarding.checklist</field>
        <field name="arch" type="xml">
            <calendar string="Clearance SLA Calendar" date_start="due_date" color="assigned_user_id" mode="month">
                <field name="title"/>
                <field name="employee_id"/>
                <field name="assigned_user_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="action_onehr_offboarding_checklist" model="ir.actions.act_window">
        <field name="name">Clearance Tasks</field>
        <field name="res_model">onehr.offboarding.checklist</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="search_view_id" ref="view_onehr_offboarding_checklist_search"/>
        <field name="group_ids" eval="[Command.link(ref('onehr_retirement_offboarding.group_onehr_offboarding_task_owner'))]"/>
    </record>

    <record id="action_onehr_my_offboarding_checklist" model="ir.actions.act_window">
        <field name="name">My Clearance Tasks</field>
        <field name="res_model">onehr.offboarding.checklist</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="domain">[('assigned_user_id', '=', uid)]</field>
        <field name="search_view_id" ref="view_onehr_offboarding_checklist_search"/>
        <field name="group_ids" eval="[Command.link(ref('onehr_retirement_offboarding.group_onehr_offboarding_task_owner'))]"/>
    </record>
</odoo>
