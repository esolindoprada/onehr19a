<odoo>
    <!-- Global company boundaries are non-negotiable and cannot be OR-ed away. -->
    <record id="rule_onehr_offboarding_company" model="ir.rule">
        <field name="name">Offboarding Case — company boundary</field>
        <field name="model_id" ref="model_onehr_offboarding"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_onehr_offboarding_checklist_company" model="ir.rule">
        <field name="name">Offboarding Checklist — company boundary</field>
        <field name="model_id" ref="model_onehr_offboarding_checklist"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_onehr_clearance_item_company" model="ir.rule">
        <field name="name">Clearance Item — global/company boundary</field>
        <field name="model_id" ref="model_onehr_clearance_item"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_onehr_exit_interview_company" model="ir.rule">
        <field name="name">Exit Interview — company boundary</field>
        <field name="model_id" ref="model_onehr_exit_interview"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Task owners see only their employee case or cases containing assigned tasks. -->
    <record id="rule_onehr_offboarding_task_owner_visibility" model="ir.rule">
        <field name="name">Offboarding Case — task-owner participation</field>
        <field name="model_id" ref="model_onehr_offboarding"/>
        <field name="groups" eval="[Command.link(ref('onehr_retirement_offboarding.group_onehr_offboarding_task_owner'))]"/>
        <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('checklist_ids.assigned_user_id', '=', user.id)]</field>
    </record>
    <record id="rule_onehr_offboarding_officer_visibility" model="ir.rule">
        <field name="name">Offboarding Case — officer company visibility</field>
        <field name="model_id" ref="model_onehr_offboarding"/>
        <field name="groups" eval="[Command.link(ref('onehr_retirement_offboarding.group_onehr_offboarding_officer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_onehr_checklist_task_owner_visibility" model="ir.rule">
        <field name="name">Offboarding Checklist — assigned task owner</field>
        <field name="model_id" ref="model_onehr_offboarding_checklist"/>
        <field name="groups" eval="[Command.link(ref('onehr_retirement_offboarding.group_onehr_offboarding_task_owner'))]"/>
        <field name="domain_force">[('assigned_user_id', '=', user.id)]</field>
    </record>
    <record id="rule_onehr_checklist_officer_visibility" model="ir.rule">
        <field name="name">Offboarding Checklist — officer company visibility</field>
        <field name="model_id" ref="model_onehr_offboarding_checklist"/>
        <field name="groups" eval="[Command.link(ref('onehr_retirement_offboarding.group_onehr_offboarding_officer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
