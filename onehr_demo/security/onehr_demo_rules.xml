
<odoo>
    <record id="rule_onehr_demo_scenario_company" model="ir.rule">
        <field name="name">OneHR Demo Scenario — allowed companies</field>
        <field name="model_id" ref="model_onehr_demo_scenario"/>
        <field name="groups" eval="[Command.link(ref('onehr_demo.group_onehr_demo_viewer'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
