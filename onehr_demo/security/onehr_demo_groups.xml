
<odoo>
    <record id="module_category_onehr_demo" model="ir.module.category">
        <field name="name">OneHR Enterprise Demo</field>
        <field name="description">Non-production enterprise demo dataset governance.</field>
        <field name="sequence">90</field>
    </record>

    <record id="privilege_onehr_demo" model="res.groups.privilege">
        <field name="name">OneHR Enterprise Demo</field>
        <field name="description">Read, operate and administer the OneHR Demo Dataset control plane.</field>
        <field name="category_id" ref="module_category_onehr_demo"/>
        <field name="sequence">90</field>
    </record>

    <record id="group_onehr_demo_viewer" model="res.groups">
        <field name="name">Demo Evidence Viewer</field>
        <field name="privilege_id" ref="privilege_onehr_demo"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Read scenario/run/checkpoint/reference/log evidence only. No generation authority.</field>
    </record>

    <record id="group_onehr_demo_operator" model="res.groups">
        <field name="name">Demo Operator</field>
        <field name="privilege_id" ref="privilege_onehr_demo"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[Command.link(ref('onehr_demo.group_onehr_demo_viewer'))]"/>
        <field name="comment">Reserved for future bounded non-destructive operating tasks.</field>
    </record>

    <record id="group_onehr_demo_admin" model="res.groups">
        <field name="name">Demo Administrator</field>
        <field name="privilege_id" ref="privilege_onehr_demo"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[Command.link(ref('onehr_demo.group_onehr_demo_operator'))]"/>
        <field name="comment">Owns Demo Control Center configuration. High-impact actions additionally require Odoo System Administrator.</field>
    </record>
</odoo>

