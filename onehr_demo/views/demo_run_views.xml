
<odoo>
    <record id="view_onehr_demo_run_list" model="ir.ui.view">
        <field name="name">onehr.demo.run.list</field>
        <field name="model">onehr.demo.run</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-success="state == 'pass'"
                  decoration-danger="state == 'failed'"
                  decoration-warning="state == 'blocked'">
                <field name="name"/><field name="scenario_id"/><field name="run_type"/><field name="profile"/>
                <field name="state" widget="badge"/><field name="operator_id"/><field name="started_at"/><field name="finished_at"/>
                <field name="checkpoint_count"/>
                <button name="action_open_checkpoints" type="object" string="Checkpoints" icon="fa-list"/>
            </list>
        </field>
    </record>
    <record id="view_onehr_demo_run_form" model="ir.ui.view">
        <field name="name">onehr.demo.run.form</field>
        <field name="model">onehr.demo.run</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_open_checkpoints" type="object" string="Open Checkpoints" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,running,pass,failed,blocked"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_checkpoints" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="checkpoint_count" widget="statinfo" string="Checkpoints"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1><div><field name="run_key"/></div></div>
                    <group>
                        <group string="Execution">
                            <field name="scenario_id"/><field name="company_id"/><field name="run_type"/><field name="profile"/><field name="operator_id"/>
                        </group>
                        <group string="Scenario Clock">
                            <field name="reference_date"/><field name="reference_datetime"/><field name="timezone"/>
                            <field name="deterministic_seed"/><field name="scenario_version"/>
                        </group>
                    </group>
                    <group string="Result">
                        <group><field name="created_count"/><field name="reused_count"/><field name="updated_count"/></group>
                        <group><field name="skipped_count"/><field name="protected_count"/><field name="source_compatibility_fingerprint"/></group>
                    </group>
                    <notebook>
                        <page string="Summary"><field name="result_summary" nolabel="1"/></page>
                        <page string="Failure Evidence">
                            <group><field name="root_cause_classification"/><field name="first_actionable_root_cause"/></group>
                        </page>
                        <page string="Checkpoints">
                            <field name="checkpoint_ids" nolabel="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="sequence"/><field name="generator_key"/><field name="state" widget="badge"/>
                                    <field name="created_count"/><field name="reused_count"/><field name="duration_seconds"/>
                                    <button name="action_open_generator" type="object" string="Generator" icon="fa-external-link"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_onehr_demo_run_search" model="ir.ui.view">
        <field name="name">onehr.demo.run.search</field>
        <field name="model">onehr.demo.run</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="scenario_id"/><field name="operator_id"/>
                <filter name="pass" string="PASS" domain="[('state','=','pass')]"/>
                <filter name="failed" string="Failed" domain="[('state','=','failed')]"/>
                <filter name="blocked" string="Blocked" domain="[('state','=','blocked')]"/>
                <group>
                    <filter name="group_scenario" string="Scenario" context="{'group_by':'scenario_id'}"/>
                    <filter name="group_type" string="Run Type" context="{'group_by':'run_type'}"/>
                    <filter name="group_state" string="State" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_onehr_demo_runs" model="ir.actions.act_window">
        <field name="name">Demo Runs</field>
        <field name="res_model">onehr.demo.run</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_onehr_demo_run_search"/>
        <field name="group_ids" eval="[Command.link(ref('onehr_demo.group_onehr_demo_viewer'))]"/>
        <field name="context">{'create': False}</field>
    </record>
</odoo>

