
<odoo>
    <record id="view_onehr_demo_log_list" model="ir.ui.view">
        <field name="name">onehr.demo.log.list</field>
        <field name="model">onehr.demo.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-danger="severity == 'error'"
                  decoration-warning="severity == 'warning'">
                <field name="event_at"/><field name="scenario_id"/><field name="run_id"/><field name="generator_key"/>
                <field name="category"/><field name="severity" widget="badge"/><field name="root_cause_classification"/>
                <field name="message"/>
            </list>
        </field>
    </record>
    <record id="view_onehr_demo_log_form" model="ir.ui.view">
        <field name="name">onehr.demo.log.form</field>
        <field name="model">onehr.demo.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <widget name="web_ribbon" title="IMMUTABLE EVIDENCE"/>
                    <div class="oe_title"><h1><field name="message"/></h1></div>
                    <group>
                        <group string="Context">
                            <field name="event_at"/><field name="scenario_id"/><field name="company_id"/>
                            <field name="run_id"/><field name="generator_id"/><field name="generator_key"/>
                        </group>
                        <group string="Classification">
                            <field name="category"/><field name="severity"/><field name="root_cause_classification"/>
                        </group>
                    </group>
                    <field name="technical_detail" nolabel="1" groups="onehr_demo.group_onehr_demo_admin"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_onehr_demo_log_search" model="ir.ui.view">
        <field name="name">onehr.demo.log.search</field>
        <field name="model">onehr.demo.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="message"/><field name="scenario_id"/><field name="generator_key"/>
                <filter name="errors" string="Errors" domain="[('severity','=','error')]"/>
                <filter name="warnings" string="Warnings" domain="[('severity','=','warning')]"/>
                <group>
                    <filter name="group_scenario" string="Scenario" context="{'group_by':'scenario_id'}"/>
                    <filter name="group_category" string="Category" context="{'group_by':'category'}"/>
                    <filter name="group_severity" string="Severity" context="{'group_by':'severity'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_onehr_demo_logs" model="ir.actions.act_window">
        <field name="name">Demo Logs</field>
        <field name="res_model">onehr.demo.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_onehr_demo_log_search"/>
        <field name="group_ids" eval="[Command.link(ref('onehr_demo.group_onehr_demo_viewer'))]"/>
        <field name="context">{'create': False}</field>
    </record>
</odoo>

