
<odoo>
    <record id="view_onehr_demo_checkpoint_list" model="ir.ui.view">
        <field name="name">onehr.demo.checkpoint.list</field>
        <field name="model">onehr.demo.checkpoint</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-success="state == 'pass'"
                  decoration-danger="state == 'failed'"
                  decoration-warning="state == 'blocked'">
                <field name="run_id"/><field name="sequence"/><field name="generator_key"/>
                <field name="state" widget="badge"/><field name="attempt"/>
                <field name="created_count"/><field name="reused_count"/><field name="updated_count"/>
                <field name="skipped_count"/><field name="protected_count"/><field name="duration_seconds"/>
                <button name="action_open_generator" type="object" string="Generator" icon="fa-external-link"/>
                <button name="action_open_run" type="object" string="Run" icon="fa-play"/>
            </list>
        </field>
    </record>
    <record id="view_onehr_demo_checkpoint_form" model="ir.ui.view">
        <field name="name">onehr.demo.checkpoint.form</field>
        <field name="model">onehr.demo.checkpoint</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_open_generator" type="object" string="Open Generator"/>
                    <button name="action_open_run" type="object" string="Open Run"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,running,pass,failed,blocked,skipped"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="generator_key"/></h1></div>
                    <group>
                        <group string="Execution">
                            <field name="run_id"/><field name="scenario_id"/><field name="company_id"/>
                            <field name="generator_id"/><field name="sequence"/><field name="attempt"/>
                        </group>
                        <group string="Timing">
                            <field name="started_at"/><field name="finished_at"/><field name="duration_seconds"/>
                        </group>
                    </group>
                    <group string="Result Counts">
                        <group><field name="created_count"/><field name="reused_count"/><field name="updated_count"/></group>
                        <group><field name="skipped_count"/><field name="protected_count"/></group>
                    </group>
                    <notebook>
                        <page string="Validation"><field name="validation_summary" nolabel="1"/></page>
                        <page string="Failure Evidence">
                            <group><field name="root_cause_classification"/><field name="first_actionable_root_cause"/></group>
                            <field name="technical_detail" nolabel="1" groups="onehr_demo.group_onehr_demo_admin"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_onehr_demo_checkpoint_search" model="ir.ui.view">
        <field name="name">onehr.demo.checkpoint.search</field>
        <field name="model">onehr.demo.checkpoint</field>
        <field name="arch" type="xml">
            <search>
                <field name="generator_key"/><field name="run_id"/><field name="scenario_id"/>
                <filter name="pass" string="PASS" domain="[('state','=','pass')]"/>
                <filter name="failed" string="Failed" domain="[('state','=','failed')]"/>
                <filter name="blocked" string="Blocked" domain="[('state','=','blocked')]"/>
                <group>
                    <filter name="group_scenario" string="Scenario" context="{'group_by':'scenario_id'}"/>
                    <filter name="group_run" string="Run" context="{'group_by':'run_id'}"/>
                    <filter name="group_state" string="State" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_onehr_demo_checkpoints" model="ir.actions.act_window">
        <field name="name">Demo Checkpoints</field>
        <field name="res_model">onehr.demo.checkpoint</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_onehr_demo_checkpoint_search"/>
        <field name="group_ids" eval="[Command.link(ref('onehr_demo.group_onehr_demo_viewer'))]"/>
        <field name="context">{'create': False}</field>
    </record>
</odoo>

