
<odoo>
    <record id="view_onehr_demo_reference_list" model="ir.ui.view">
        <field name="name">onehr.demo.reference.list</field>
        <field name="model">onehr.demo.reference</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-muted="state == 'invalidated'"
                  decoration-warning="state == 'protected'">
                <field name="stable_key"/><field name="generator_key"/><field name="target_model"/>
                <field name="target_display_name"/><field name="disposition" widget="badge"/>
                <field name="reset_policy"/><field name="state" widget="badge"/><field name="last_seen_run_id"/>
                <button name="action_open_target" type="object" string="Target" icon="fa-external-link"/>
                <button name="action_open_run" type="object" string="Run" icon="fa-play"/>
            </list>
        </field>
    </record>
    <record id="view_onehr_demo_reference_form" model="ir.ui.view">
        <field name="name">onehr.demo.reference.form</field>
        <field name="model">onehr.demo.reference</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_open_target" type="object" string="Open Target" class="oe_highlight"/>
                    <button name="action_open_run" type="object" string="Open Last Run"/>
                    <field name="state" widget="statusbar" statusbar_visible="active,protected,invalidated"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="stable_key"/></h1></div>
                    <group>
                        <group string="Ownership">
                            <field name="scenario_id"/><field name="company_id"/><field name="generator_id"/>
                            <field name="generator_key"/><field name="originating_run_id"/><field name="last_seen_run_id"/>
                        </group>
                        <group string="Target">
                            <field name="target_model"/><field name="target_res_id"/><field name="target_display_name"/>
                            <field name="disposition"/><field name="reset_policy"/>
                        </group>
                    </group>
                    <group string="Evidence">
                        <field name="created_at"/><field name="last_seen_at"/><field name="source_compatibility_fingerprint"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_onehr_demo_reference_search" model="ir.ui.view">
        <field name="name">onehr.demo.reference.search</field>
        <field name="model">onehr.demo.reference</field>
        <field name="arch" type="xml">
            <search>
                <field name="stable_key"/><field name="target_model"/><field name="target_display_name"/><field name="scenario_id"/>
                <filter name="active" string="Active" domain="[('state','=','active')]"/>
                <filter name="protected" string="Protected" domain="[('state','=','protected')]"/>
                <group>
                    <filter name="group_scenario" string="Scenario" context="{'group_by':'scenario_id'}"/>
                    <filter name="group_generator" string="Generator" context="{'group_by':'generator_id'}"/>
                    <filter name="group_model" string="Target Model" context="{'group_by':'target_model'}"/>
                    <filter name="group_reset" string="Reset Policy" context="{'group_by':'reset_policy'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_onehr_demo_references" model="ir.actions.act_window">
        <field name="name">Demo References</field>
        <field name="res_model">onehr.demo.reference</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_onehr_demo_reference_search"/>
        <field name="group_ids" eval="[Command.link(ref('onehr_demo.group_onehr_demo_viewer'))]"/>
        <field name="context">{'create': False}</field>
    </record>
</odoo>

