<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_onehr_payroll_export" model="ir.sequence">
        <field name="name">OneHR Payroll Export</field>
        <field name="code">onehr.payroll.export</field>
        <field name="prefix">PAYEXP/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_onehr_payroll_import" model="ir.sequence">
        <field name="name">OneHR Payroll Import</field>
        <field name="code">onehr.payroll.import</field>
        <field name="prefix">PAYIMP/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
