<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_onehr_payroll_import_list" model="ir.ui.view">
        <field name="name">onehr.payroll.import.list.enterprise</field>
        <field name="model">onehr.payroll.import</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'"
                  decoration-success="state in ['validated', 'reconciled']"
                  decoration-warning="state == 'error'"
                  decoration-muted="state == 'superseded'">
                <field name="name"/>
                <field name="export_id"/>
                <field name="employee_number_snapshot"/>
                <field name="employee_name_snapshot"/>
                <field name="department_snapshot" optional="show"/>
                <field name="payslip_number" optional="show"/>
                <field name="external_reference"/>
                <field name="revision"/>
                <field name="gross_amount" sum="Gross"/>
                <field name="deduction_amount" sum="Deductions"/>
                <field name="net_amount" sum="Net"/>
                <field name="employer_cost" sum="Employer Cost"/>
                <field name="currency_id" optional="hide"/>
                <field name="payment_date" optional="show"/>
                <field name="source_channel" widget="badge" optional="show"/>
                <field name="is_current_revision" widget="boolean"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="state" widget="badge"/>
                <button name="action_validate" type="object" string="Validate" icon="fa-check"
                        invisible="state not in ['draft', 'error'] or not is_current_revision"
                        groups="onehr_payroll_bridge.group_onehr_payroll_officer,onehr_payroll_bridge.group_onehr_payroll_manager"/>
                <button name="action_open_export" type="object" string="Export" icon="fa-external-link"/>
                <button name="action_create_correction" type="object" string="Correct" icon="fa-code-fork"
                        invisible="state == 'reconciled' or not is_current_revision"
                        groups="onehr_payroll_bridge.group_onehr_payroll_manager"/>
            </list>
        </field>
    </record>

    <record id="view_onehr_payroll_import_form" model="ir.ui.view">
        <field name="name">onehr.payroll.import.form.enterprise</field>
        <field name="model">onehr.payroll.import</field>
        <field name="arch" type="xml">
            <form string="Imported Payroll Result">
                <header>
                    <button name="action_validate" type="object" string="Validate Result"
                            class="oe_highlight"
                            invisible="state not in ['draft', 'error'] or not is_current_revision"
                            groups="onehr_payroll_bridge.group_onehr_payroll_officer,onehr_payroll_bridge.group_onehr_payroll_manager"/>
                    <button name="action_create_correction" type="object" string="Create Correction Revision"
                            invisible="state == 'reconciled' or not is_current_revision"
                            groups="onehr_payroll_bridge.group_onehr_payroll_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validated,reconciled,error,superseded"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_export" type="object" class="oe_stat_button" icon="fa-upload"
                                groups="onehr_payroll_bridge.group_onehr_payroll_officer,onehr_payroll_bridge.group_onehr_payroll_manager">
                            <div class="o_stat_info"><span class="o_stat_text">Payroll Export</span></div>
                        </button>
                        <button name="action_open_employee" type="object" class="oe_stat_button" icon="fa-user"
                                invisible="not employee_id"
                                groups="onehr_payroll_bridge.group_onehr_payroll_officer,onehr_payroll_bridge.group_onehr_payroll_manager">
                            <div class="o_stat_info"><span class="o_stat_text">Employee</span></div>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Validated" bg_color="text-bg-success" invisible="state != 'validated'"/>
                    <widget name="web_ribbon" title="Reconciled" bg_color="text-bg-success" invisible="state != 'reconciled'"/>
                    <widget name="web_ribbon" title="Validation Error" bg_color="text-bg-warning" invisible="state != 'error'"/>
                    <widget name="web_ribbon" title="Superseded" bg_color="text-bg-secondary" invisible="state != 'superseded'"/>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                        <div class="text-muted">
                            <field name="external_reference" readonly="state not in ['draft', 'error']"/>
                            <span> · Revision </span>
                            <field name="revision" readonly="1"/>
                        </div>
                    </div>

                    <group>
                        <group string="Payroll Result Identity">
                            <field name="export_id" readonly="state not in ['draft', 'error']" domain="[('state', '=', 'posted')]"/>
                            <field name="config_id" readonly="1"/>
                            <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                            <field name="source_channel" readonly="state not in ['draft', 'error']"/>
                            <field name="payslip_number" readonly="state not in ['draft', 'error']"/>
                            <field name="payment_date" readonly="state not in ['draft', 'error']"/>
                        </group>
                        <group string="Employee Snapshot">
                            <field name="employee_id" readonly="state not in ['draft', 'error']"
                                   options="{'no_create': True}"/>
                            <field name="employee_number_snapshot" readonly="state not in ['draft', 'error']"/>
                            <field name="employee_name_snapshot" readonly="1"/>
                            <field name="department_snapshot" readonly="1"/>
                            <field name="grade_code_snapshot" readonly="1"/>
                            <field name="position_code_snapshot" readonly="1"/>
                        </group>
                    </group>

                    <group string="Payroll Amounts">
                        <group>
                            <field name="gross_amount" readonly="state not in ['draft', 'error']"/>
                            <field name="deduction_amount" readonly="state not in ['draft', 'error']"/>
                            <field name="net_amount" readonly="state not in ['draft', 'error']"/>
                        </group>
                        <group>
                            <field name="employer_cost" readonly="state not in ['draft', 'error']"/>
                            <field name="currency_id" readonly="state not in ['draft', 'error']"/>
                            <field name="net_equation_delta" readonly="1"/>
                            <field name="period_start" readonly="1"/>
                            <field name="period_end" readonly="1"/>
                        </group>
                    </group>

                    <group string="Operational Navigation">
                        <button name="action_open_export" type="object" string="Open Source Export"
                                icon="fa-external-link"
                                groups="onehr_payroll_bridge.group_onehr_payroll_officer,onehr_payroll_bridge.group_onehr_payroll_manager"/>
                        <button name="action_open_employee" type="object" string="Open Employee"
                                icon="fa-user" invisible="not employee_id"
                                groups="onehr_payroll_bridge.group_onehr_payroll_officer,onehr_payroll_bridge.group_onehr_payroll_manager"/>
                    </group>

                    <notebook>
                        <page string="Validation" name="validation">
                            <group>
                                <field name="is_current_revision" readonly="1"/>
                                <field name="validation_message" readonly="1"/>
                                <field name="validated_at" readonly="1"/>
                                <field name="validated_by_id" readonly="1"/>
                                <field name="reconciled_at" readonly="1"/>
                                <field name="reconciled_by_id" readonly="1"/>
                            </group>
                        </page>
                        <page string="Revision History" name="revision_history">
                            <group>
                                <field name="supersedes_id" readonly="1"/>
                                <field name="superseded_by_ids" readonly="1">
                                    <list create="0" edit="0" delete="0">
                                        <field name="name"/>
                                        <field name="revision"/>
                                        <field name="external_reference"/>
                                        <field name="net_amount"/>
                                        <field name="state" widget="badge"/>
                                        <button name="action_open_export" type="object" string="Export" icon="fa-external-link"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Raw Vendor Evidence" name="raw_payload"
                              groups="onehr_payroll_bridge.group_onehr_payroll_officer,onehr_payroll_bridge.group_onehr_payroll_manager">
                            <field name="raw_payload_json" nolabel="1" readonly="state not in ['draft', 'error']"/>
                        </page>
                    </notebook>
                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_onehr_payroll_import_search" model="ir.ui.view">
        <field name="name">onehr.payroll.import.search.enterprise</field>
        <field name="model">onehr.payroll.import</field>
        <field name="arch" type="xml">
            <search string="Imported Payroll Results">
                <field name="name"/>
                <field name="export_id"/>
                <field name="employee_number_snapshot"/>
                <field name="employee_name_snapshot"/>
                <field name="external_reference"/>
                <field name="payslip_number"/>
                <field name="department_snapshot"/>
                <separator/>
                <filter name="current" string="Current Revision" domain="[('is_current_revision', '=', True)]"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="validated" string="Validated" domain="[('state', '=', 'validated')]"/>
                <filter name="errors" string="Validation Errors" domain="[('state', '=', 'error')]"/>
                <filter name="reconciled" string="Reconciled" domain="[('state', '=', 'reconciled')]"/>
                <filter name="period_end_filter" string="Period End" date="period_end"/>
                <separator/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_export" string="Export" context="{'group_by': 'export_id'}"/>
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_period" string="Period End" context="{'group_by': 'period_end:month'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_onehr_payroll_import_pivot" model="ir.ui.view">
        <field name="name">onehr.payroll.import.pivot.enterprise</field>
        <field name="model">onehr.payroll.import</field>
        <field name="arch" type="xml">
            <pivot string="Payroll Cost Analysis">
                <field name="company_id" type="row"/>
                <field name="department_id" type="row"/>
                <field name="period_end" type="col" interval="month"/>
                <field name="gross_amount" type="measure"/>
                <field name="deduction_amount" type="measure"/>
                <field name="net_amount" type="measure"/>
                <field name="employer_cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_onehr_payroll_import_graph" model="ir.ui.view">
        <field name="name">onehr.payroll.import.graph.enterprise</field>
        <field name="model">onehr.payroll.import</field>
        <field name="arch" type="xml">
            <graph string="Payroll Cost by Department" type="bar">
                <field name="department_id"/>
                <field name="employer_cost" type="measure"/>
                <field name="net_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_onehr_payroll_imports" model="ir.actions.act_window">
        <field name="name">Imported Payroll Results</field>
        <field name="res_model">onehr.payroll.import</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="view_onehr_payroll_import_search"/>
        <field name="context">{'search_default_current': 1}</field>
    </record>
</odoo>
