<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_onehr_payroll_bridge" model="ir.module.category">
        <field name="name">OneHR Payroll Bridge</field>
        <field name="description">Payroll interchange, reconciliation and costing bridge authority.</field>
        <field name="sequence">48</field>
    </record>

    <record id="privilege_onehr_payroll_bridge" model="res.groups.privilege">
        <field name="name">OneHR Payroll Bridge</field>
        <field name="description">Payroll export/import operations and reconciliation governance.</field>
        <field name="category_id" ref="module_category_onehr_payroll_bridge"/>
        <field name="sequence">48</field>
    </record>

    <record id="group_onehr_payroll_officer" model="res.groups">
        <field name="name">Payroll Officer</field>
        <field name="privilege_id" ref="privilege_onehr_payroll_bridge"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[
            Command.link(ref('onehr_security.group_onehr_security_user')),
            Command.link(ref('hr.group_hr_user'))
        ]"/>
        <field name="comment">Prepares payroll exchange batches and validates vendor payroll results. This role intentionally does not imply OneHR sensitive/restricted-data reader groups.</field>
    </record>

    <record id="group_onehr_payroll_manager" model="res.groups">
        <field name="name">Payroll Manager</field>
        <field name="privilege_id" ref="privilege_onehr_payroll_bridge"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[
            Command.link(ref('onehr_payroll_bridge.group_onehr_payroll_officer'))
        ]"/>
        <field name="comment">Owns payroll bridge configuration, final posting, reconciliation, correction revision and controlled draft cleanup.</field>
    </record>
</odoo>
