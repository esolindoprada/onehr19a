<odoo noupdate="1">
    <record id="ir_cron_onehr_document_expiry" model="ir.cron">
        <field name="name">OneHR Document — Expiry and Reminder Governance</field>
        <field name="model_id" ref="model_onehr_document_version"/>
        <field name="state">code</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="code">model._cron_process_expiry_and_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
