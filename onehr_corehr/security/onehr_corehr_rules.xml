<odoo>
    <record id="rule_onehr_dependent_company" model="ir.rule">
        <field name="name">OneHR Dependents — allowed companies</field>
        <field name="model_id" ref="model_onehr_employee_dependent"/>
        <field name="groups" eval="[Command.link(ref('onehr_corehr.group_onehr_corehr_officer'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

