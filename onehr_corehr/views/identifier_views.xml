<odoo>
    <record id="view_onehr_identifier_list" model="ir.ui.view">
        <field name="name">onehr.employee.identifier.list.enterprise</field>
        <field name="model">onehr.employee.identifier</field>
        <field name="arch" type="xml">
            <list decoration-success="verified and active" decoration-muted="not active">
                <field name="reference"/>
                <field name="employee_id"/>
                <field name="identifier_type" widget="badge"/>
                <field name="masked_value"/>
                <field name="issuer" optional="show"/>
                <field name="country_id" optional="hide"/>
                <field name="verified"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="valid_from"/>
                <field name="valid_to" optional="show"/>
                <field name="active" optional="hide"/>
                <button name="action_verify" type="object" string="Verify" icon="fa-check" invisible="verified or not active"/>
                <button name="action_expire" type="object" string="Expire" icon="fa-ban" invisible="not active"/>
            </list>
        </field>
    </record>

    <record id="view_onehr_identifier_form" model="ir.ui.view">
        <field name="name">onehr.employee.identifier.form.enterprise</field>
        <field name="model">onehr.employee.identifier</field>
        <field name="arch" type="xml">
            <form string="Restricted Employee Identifier">
                <header>
                    <button name="action_verify" type="object" string="Verify"
                            class="btn-primary" invisible="verified or not active"/>
                    <button name="action_expire" type="object" string="Expire" invisible="not active"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_employee" type="object" class="oe_stat_button" icon="fa-user">
                            <div class="o_stat_info"><span class="o_stat_text">Employee</span></div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Verified" bg_color="text-bg-success" invisible="not verified or not active"/>
                    <widget name="web_ribbon" title="Expired" bg_color="text-bg-secondary" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title"><h1><field name="reference" readonly="1"/></h1></div>
                    <group>
                        <group string="Identifier">
                            <field name="employee_id"/>
                            <field name="identifier_type"/>
                            <field name="identifier_value" password="True"/>
                            <field name="masked_value" readonly="1"/>
                            <field name="issuer"/>
                            <field name="country_id"/>
                        </group>
                        <group string="Control">
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="valid_from"/>
                            <field name="valid_to"/>
                            <field name="verified" readonly="1"/>
                            <field name="verified_at" readonly="1"/>
                            <field name="verified_by_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook><page string="Restricted Notes"><field name="notes"/></page></notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_onehr_identifier_search" model="ir.ui.view">
        <field name="name">onehr.employee.identifier.search.enterprise</field>
        <field name="model">onehr.employee.identifier</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="employee_id"/>
                <field name="identifier_type"/>
                <field name="issuer"/>
                <field name="country_id"/>
                <field name="company_id"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="verified" string="Verified" domain="[('verified', '=', True)]"/>
                <filter name="unverified" string="Unverified" domain="[('verified', '=', False), ('active', '=', True)]"/>
                <group>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'identifier_type'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_onehr_identifiers" model="ir.actions.act_window">
        <field name="name">Employee Identifiers</field>
        <field name="res_model">onehr.employee.identifier</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_onehr_identifier_search"/>
    </record>
</odoo>
