
<odoo>
    <record id="view_onehr_engagement_type_list" model="ir.ui.view">
        <field name="name">onehr.engagement.type.list.enterprise</field>
        <field name="model">onehr.engagement.type</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="native_employee_type" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="valid_from"/>
                <field name="valid_to" optional="show"/>
                <field name="version_count" string="Employee Versions"/>
                <field name="active" optional="hide"/>
                <button name="action_open_versions" type="object" string="Versions" icon="fa-history"/>
            </list>
        </field>
    </record>

    <record id="view_onehr_engagement_type_form" model="ir.ui.view">
        <field name="name">onehr.engagement.type.form.enterprise</field>
        <field name="model">onehr.engagement.type</field>
        <field name="arch" type="xml">
            <form string="OneHR Engagement Type">
                <header>
                    <button name="action_archive" type="object" string="Archive"
                            groups="onehr_corehr.group_onehr_corehr_manager"
                            invisible="not active"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_versions" type="object" class="oe_stat_button" icon="fa-history">
                            <field name="version_count" widget="statinfo" string="Employee Versions"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-secondary" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Permanent Salaried"/></h1>
                    </div>
                    <group>
                        <group string="Business Classification">
                            <field name="code"/>
                            <field name="native_employee_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Effective Period">
                            <field name="valid_from"/>
                            <field name="valid_to"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Definition">
                            <field name="description" placeholder="Explain the enterprise engagement classification and when it is used..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_onehr_engagement_type_search" model="ir.ui.view">
        <field name="name">onehr.engagement.type.search.enterprise</field>
        <field name="model">onehr.engagement.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="native_employee_type"/>
                <field name="company_id"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_native" string="Native Employee Type" context="{'group_by': 'native_employee_type'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_onehr_engagement_types" model="ir.actions.act_window">
        <field name="name">Engagement Types</field>
        <field name="res_model">onehr.engagement.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_onehr_engagement_type_search"/>
    </record>
</odoo>
