
<odoo>
    <record id="module_category_onehr_branch" model="ir.module.category">
        <field name="name">OneHR Branch</field>
        <field name="description">Operational branch scope, central visibility and branch administration.</field>
        <field name="sequence">37</field>
    </record>

    <record id="privilege_onehr_branch" model="res.groups.privilege">
        <field name="name">OneHR Branch</field>
        <field name="description">OneHR branch visibility, management and branch-scope administration.</field>
        <field name="category_id" ref="module_category_onehr_branch"/>
        <field name="sequence">37</field>
    </record>

    <record id="group_onehr_branch_user" model="res.groups">
        <field name="name">Branch User</field>
        <field name="privilege_id" ref="privilege_onehr_branch"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Read branch masters inside explicit allowed-branch scope. Does not grant HR or Security administration.</field>
    </record>

    <record id="group_onehr_branch_manager" model="res.groups">
        <field name="name">Branch Manager</field>
        <field name="privilege_id" ref="privilege_onehr_branch"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[Command.link(ref('onehr_multicompany_branch.group_onehr_branch_user'))]"/>
        <field name="comment">Operational branch manager. Branch visibility remains limited to explicit allowed branches.</field>
    </record>

    <record id="group_onehr_branch_admin" model="res.groups">
        <field name="name">Branch Admin</field>
        <field name="privilege_id" ref="privilege_onehr_branch"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[Command.link(ref('onehr_multicompany_branch.group_onehr_branch_manager'))]"/>
        <field name="comment">Administers branch masters and user branch scope inside allowed legal companies. Does not imply OneHR Security Admin.</field>
    </record>

    <record id="group_onehr_central_office" model="res.groups">
        <field name="name">Central Office</field>
        <field name="privilege_id" ref="privilege_onehr_branch"/>
        <field name="sequence">40</field>
        <field name="implied_ids" eval="[Command.link(ref('onehr_multicompany_branch.group_onehr_branch_user'))]"/>
        <field name="comment">Read consolidated branch-role coverage across explicitly assigned branches; no branch/security mutation authority.</field>
    </record>
</odoo>

