<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_onehr_recruitment" model="ir.module.category">
        <field name="name">OneHR Recruitment</field>
        <field name="description">Enterprise requisition, interview, offer and preboarding governance.</field>
        <field name="sequence">39</field>
    </record>

    <record id="privilege_onehr_recruitment" model="res.groups.privilege">
        <field name="name">OneHR Recruitment</field>
        <field name="description">Recruitment operations and governed hiring decisions.</field>
        <field name="category_id" ref="module_category_onehr_recruitment"/>
        <field name="sequence">39</field>
    </record>

    <record id="group_onehr_hiring_manager" model="res.groups">
        <field name="name">Hiring Manager</field>
        <field name="privilege_id" ref="privilege_onehr_recruitment"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[
            Command.link(ref('hr_recruitment.group_hr_recruitment_interviewer')),
            Command.link(ref('onehr_workflow_approval.group_onehr_approval_user'))
        ]"/>
        <field name="comment">Assigned hiring managers/interviewers. No recruiter-wide visibility and no offer-compensation field entitlement.</field>
    </record>

    <record id="group_onehr_recruiter" model="res.groups">
        <field name="name">Recruiter</field>
        <field name="privilege_id" ref="privilege_onehr_recruitment"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[
            Command.link(ref('hr_recruitment.group_hr_recruitment_user')),
            Command.link(ref('onehr_workflow_approval.group_onehr_approval_user'))
        ]"/>
        <field name="comment">Operational recruiter authority across allowed companies; no deletion of governed recruitment evidence.</field>
    </record>

    <record id="group_onehr_recruitment_manager" model="res.groups">
        <field name="name">Recruitment Manager</field>
        <field name="privilege_id" ref="privilege_onehr_recruitment"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[
            Command.link(ref('group_onehr_recruiter')),
            Command.link(ref('group_onehr_hiring_manager')),
            Command.link(ref('hr_recruitment.group_hr_recruitment_manager')),
            Command.link(ref('hr.group_hr_user')),
            Command.link(ref('onehr_workflow_approval.group_onehr_approver'))
        ]"/>
        <field name="comment">Recruitment configuration/decision authority, including governed hire conversion. Sensitive CoreHR specialist domains remain separately protected.</field>
    </record>
</odoo>
