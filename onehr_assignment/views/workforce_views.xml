<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_onehr_workforce_plan_list" model="ir.ui.view">
        <field name="name">onehr.workforce.plan.list.enterprise</field><field name="model">onehr.workforce.plan</field>
        <field name="arch" type="xml"><list decoration-info="state == 'proposed'" decoration-warning="state == 'approved'" decoration-success="state == 'active'" decoration-muted="state == 'closed'" decoration-danger="state == 'rejected'">
            <field name="plan_code"/><field name="name"/><field name="version"/><field name="scenario" widget="badge"/><field name="period_start"/><field name="period_end"/>
            <field name="line_count"/><field name="planned_headcount" sum="HC"/><field name="planned_fte" sum="FTE"/><field name="planned_cost" sum="Cost"/><field name="currency_id" column_invisible="True"/><field name="state" widget="badge"/><field name="company_id" groups="base.group_multi_company"/>
            <button name="action_open_position_budgets" type="object" string="Budgets" icon="fa-external-link"/>
        </list></field>
    </record>

    <record id="view_onehr_workforce_plan_form" model="ir.ui.view">
        <field name="name">onehr.workforce.plan.form.enterprise</field><field name="model">onehr.workforce.plan</field>
        <field name="arch" type="xml"><form string="Workforce Plan">
            <header>
                <button name="action_submit_for_approval" type="object" string="Submit for Approval" class="oe_highlight" invisible="state not in ['draft','rejected']" groups="onehr_assignment.group_onehr_assignment_manager"/>
                <button name="action_activate" type="object" string="Activate Plan &amp; Budgets" class="oe_highlight" invisible="state != 'approved'" groups="onehr_assignment.group_onehr_assignment_manager"/>
                <button name="action_create_new_version" type="object" string="Create New Version" invisible="state in ['draft','proposed']" groups="onehr_assignment.group_onehr_assignment_manager"/>
                <button name="action_close" type="object" string="Close" invisible="state != 'active'" groups="onehr_assignment.group_onehr_assignment_manager"/>
                <field name="state" widget="statusbar" statusbar_visible="draft,proposed,approved,active,closed,rejected"/>
            </header>
            <sheet>
                <div class="oe_button_box" name="button_box">
                    <button name="action_open_approval_requests" type="object" class="oe_stat_button" icon="fa-check-circle"><field name="onehr_approval_request_count" widget="statinfo" string="Approvals"/></button>
                    <button name="action_open_position_budgets" type="object" class="oe_stat_button" icon="fa-money"><div class="o_stat_info"><span class="o_stat_text">Position Budgets</span></div></button>
                </div>
                <widget name="web_ribbon" title="Active Plan" bg_color="text-bg-success" invisible="state != 'active'"/>
                <div class="oe_title"><label for="name"/><h1><field name="name"/></h1><div class="text-muted"><field name="plan_code"/> · Version <field name="version"/></div></div>
                <group><group string="Plan Identity"><field name="company_id" groups="base.group_multi_company"/><field name="plan_code"/><field name="version"/><field name="scenario"/></group><group string="Planning Period"><field name="period_start"/><field name="period_end"/><field name="predecessor_plan_id" readonly="1"/><field name="onehr_latest_approval_state" widget="badge" readonly="1"/></group></group>
                <group string="Plan Totals" col="4"><field name="planned_headcount" readonly="1"/><field name="planned_fte" readonly="1"/><field name="planned_cost" readonly="1"/><field name="currency_id" readonly="1"/></group>
                <div class="d-flex gap-2 my-3"><button name="action_open_position_budgets" type="object" string="Review Materialized Position Budgets" class="btn-secondary" icon="fa-money"/></div>
                <notebook>
                    <page string="Position Plan Lines">
                        <field name="line_ids" readonly="state not in ['draft','rejected']">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/><field name="position_id"/><field name="department_id" readonly="1" optional="show"/><field name="job_id" readonly="1" optional="show"/><field name="grade_id" readonly="1" optional="show"/>
                                <field name="planned_headcount" sum="HC"/><field name="planned_fte" sum="FTE"/><field name="planned_cost" sum="Cost"/><field name="currency_id" column_invisible="True"/><field name="rationale" optional="show"/><field name="generated_budget_id" readonly="1" optional="show"/>
                                <button name="action_open_position" type="object" string="Position" icon="fa-external-link"/><button name="action_open_budget" type="object" string="Budget" icon="fa-money" invisible="not generated_budget_id"/>
                            </list>
                        </field>
                    </page>
                    <page string="Notes"><field name="note"/></page>
                </notebook>
            </sheet><chatter/>
        </form></field>
    </record>

    <record id="view_onehr_workforce_plan_search" model="ir.ui.view">
        <field name="name">onehr.workforce.plan.search.enterprise</field><field name="model">onehr.workforce.plan</field>
        <field name="arch" type="xml"><search><field name="name"/><field name="plan_code"/><field name="scenario"/><field name="state"/><field name="company_id"/><filter name="active" string="Active" domain="[('state','=','active')]"/><filter name="approved" string="Approved" domain="[('state','=','approved')]"/><filter name="draft" string="Draft" domain="[('state','=','draft')]"/><group><filter name="group_state" string="State" context="{'group_by':'state'}"/><filter name="group_scenario" string="Scenario" context="{'group_by':'scenario'}"/><filter name="group_period" string="Period Start" context="{'group_by':'period_start:year'}"/><filter name="group_company" string="Company" context="{'group_by':'company_id'}" groups="base.group_multi_company"/></group></search></field>
    </record>

    <record id="view_onehr_workforce_plan_pivot" model="ir.ui.view"><field name="name">onehr.workforce.plan.pivot.enterprise</field><field name="model">onehr.workforce.plan</field><field name="arch" type="xml"><pivot string="Workforce Plan Analysis"><field name="scenario" type="row"/><field name="period_start" interval="year" type="col"/><field name="planned_headcount" type="measure"/><field name="planned_fte" type="measure"/><field name="planned_cost" type="measure"/></pivot></field></record>
    <record id="view_onehr_workforce_plan_graph" model="ir.ui.view"><field name="name">onehr.workforce.plan.graph.enterprise</field><field name="model">onehr.workforce.plan</field><field name="arch" type="xml"><graph string="Planned FTE by Scenario" type="bar"><field name="scenario"/><field name="planned_fte" type="measure"/></graph></field></record>
    <record id="action_onehr_workforce_plan" model="ir.actions.act_window"><field name="name">Workforce Plans</field><field name="res_model">onehr.workforce.plan</field><field name="view_mode">list,form,pivot,graph</field><field name="search_view_id" ref="view_onehr_workforce_plan_search"/></record>

    <record id="view_onehr_workforce_plan_line_list" model="ir.ui.view"><field name="name">onehr.workforce.plan.line.list.enterprise</field><field name="model">onehr.workforce.plan.line</field><field name="arch" type="xml"><list><field name="plan_id"/><field name="position_id"/><field name="department_id"/><field name="job_id" optional="show"/><field name="grade_id" optional="show"/><field name="planned_headcount" sum="HC"/><field name="planned_fte" sum="FTE"/><field name="planned_cost" sum="Cost"/><field name="currency_id" column_invisible="True"/><field name="generated_budget_id" optional="show"/><field name="company_id" groups="base.group_multi_company"/><button name="action_open_position" type="object" string="Position" icon="fa-external-link"/><button name="action_open_budget" type="object" string="Budget" icon="fa-money" invisible="not generated_budget_id"/></list></field></record>
    <record id="view_onehr_workforce_plan_line_form" model="ir.ui.view"><field name="name">onehr.workforce.plan.line.form.enterprise</field><field name="model">onehr.workforce.plan.line</field><field name="arch" type="xml"><form string="Workforce Plan Line"><sheet><div class="oe_button_box" name="button_box"><button name="action_open_position" type="object" class="oe_stat_button" icon="fa-briefcase"><div class="o_stat_info"><span class="o_stat_text">Position</span></div></button><button name="action_open_budget" type="object" class="oe_stat_button" icon="fa-money" invisible="not generated_budget_id"><div class="o_stat_info"><span class="o_stat_text">Budget</span></div></button></div><div class="oe_title"><h1><field name="position_id"/></h1></div><group><group string="Plan"><field name="plan_id"/><field name="company_id" groups="base.group_multi_company" readonly="1"/><field name="department_id" readonly="1"/><field name="job_id" readonly="1"/><field name="grade_id" readonly="1"/></group><group string="Planned Capacity"><field name="planned_headcount"/><field name="planned_fte"/><field name="planned_cost"/><field name="currency_id" readonly="1"/></group></group><group string="Governance"><field name="rationale"/><field name="generated_budget_id" readonly="1"/></group></sheet><chatter/></form></field></record>
    <record id="view_onehr_workforce_plan_line_search" model="ir.ui.view"><field name="name">onehr.workforce.plan.line.search.enterprise</field><field name="model">onehr.workforce.plan.line</field><field name="arch" type="xml"><search><field name="plan_id"/><field name="position_id"/><field name="department_id"/><field name="job_id"/><field name="grade_id"/><field name="company_id"/><filter name="materialized" string="Budget Created" domain="[('generated_budget_id','!=',False)]"/><group><filter name="group_plan" string="Plan" context="{'group_by':'plan_id'}"/><filter name="group_department" string="Department" context="{'group_by':'department_id'}"/><filter name="group_position" string="Position" context="{'group_by':'position_id'}"/><filter name="group_company" string="Company" context="{'group_by':'company_id'}" groups="base.group_multi_company"/></group></search></field></record>
    <record id="action_onehr_workforce_plan_line" model="ir.actions.act_window"><field name="name">Workforce Plan Lines</field><field name="res_model">onehr.workforce.plan.line</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_onehr_workforce_plan_line_search"/></record>

    <record id="view_onehr_position_budget_list" model="ir.ui.view"><field name="name">onehr.position.budget.list.enterprise</field><field name="model">onehr.position.budget</field><field name="arch" type="xml"><list decoration-success="state == 'active'" decoration-muted="state == 'closed'"><field name="position_id"/><field name="valid_from"/><field name="valid_to"/><field name="authorized_headcount"/><field name="assigned_headcount"/><field name="available_headcount"/><field name="authorized_fte"/><field name="assigned_fte"/><field name="available_fte"/><field name="budget_amount"/><field name="currency_id" column_invisible="True"/><field name="state" widget="badge"/><field name="company_id" groups="base.group_multi_company"/><button name="action_open_assignments" type="object" string="Assignments" icon="fa-users"/></list></field></record>
    <record id="view_onehr_position_budget_form" model="ir.ui.view"><field name="name">onehr.position.budget.form.enterprise</field><field name="model">onehr.position.budget</field><field name="arch" type="xml"><form string="Position Budget"><header><button name="action_activate" type="object" string="Activate" class="oe_highlight" invisible="state != 'draft'" groups="onehr_assignment.group_onehr_assignment_manager"/><button name="action_close" type="object" string="Close" invisible="state != 'active'" groups="onehr_assignment.group_onehr_assignment_manager"/><field name="state" widget="statusbar" statusbar_visible="draft,active,closed"/></header><sheet><div class="oe_button_box" name="button_box"><button name="action_open_assignments" type="object" class="oe_stat_button" icon="fa-users"><field name="assigned_headcount" widget="statinfo" string="Assigned HC"/></button><button name="action_open_source_plan" type="object" class="oe_stat_button" icon="fa-line-chart" invisible="not source_plan_line_id"><div class="o_stat_info"><span class="o_stat_text">Source Plan</span></div></button></div><div class="oe_title"><h1><field name="name" readonly="1"/></h1></div><group><group string="Position &amp; Period"><field name="position_id" readonly="state != 'draft'"/><field name="company_id" groups="base.group_multi_company" readonly="1"/><field name="valid_from" readonly="state != 'draft'"/><field name="valid_to" readonly="state != 'draft'"/></group><group string="Authorized Capacity"><field name="authorized_headcount" readonly="state != 'draft'"/><field name="authorized_fte" readonly="state != 'draft'"/><field name="budget_amount" readonly="state != 'draft'"/><field name="currency_id" readonly="1"/></group></group><group string="Current Occupancy Snapshot"><field name="assigned_headcount" readonly="1"/><field name="available_headcount" readonly="1"/><field name="assigned_fte" readonly="1"/><field name="available_fte" readonly="1"/></group><group string="Planning Source"><field name="source_plan_line_id" readonly="1"/></group><div class="d-flex gap-2 my-3"><button name="action_open_assignments" type="object" string="Review Position Assignments" class="btn-secondary" icon="fa-users"/></div></sheet><chatter/></form></field></record>
    <record id="view_onehr_position_budget_search" model="ir.ui.view"><field name="name">onehr.position.budget.search.enterprise</field><field name="model">onehr.position.budget</field><field name="arch" type="xml"><search><field name="position_id"/><field name="company_id"/><field name="state"/><filter name="active" string="Active" domain="[('state','=','active')]"/><filter name="draft" string="Draft" domain="[('state','=','draft')]"/><filter name="effective_today" string="Effective Today" domain="[('valid_from','&lt;=',context_today()),'|',('valid_to','=',False),('valid_to','&gt;=',context_today())]"/><group><filter name="group_position" string="Position" context="{'group_by':'position_id'}"/><filter name="group_state" string="State" context="{'group_by':'state'}"/><filter name="group_company" string="Company" context="{'group_by':'company_id'}" groups="base.group_multi_company"/></group></search></field></record>
    <record id="view_onehr_position_budget_pivot" model="ir.ui.view"><field name="name">onehr.position.budget.pivot.enterprise</field><field name="model">onehr.position.budget</field><field name="arch" type="xml"><pivot string="Position Budget Analysis"><field name="position_id" type="row"/><field name="valid_from" interval="year" type="col"/><field name="authorized_headcount" type="measure"/><field name="authorized_fte" type="measure"/><field name="budget_amount" type="measure"/></pivot></field></record>
    <record id="view_onehr_position_budget_graph" model="ir.ui.view"><field name="name">onehr.position.budget.graph.enterprise</field><field name="model">onehr.position.budget</field><field name="arch" type="xml"><graph string="Authorized FTE by Position" type="bar"><field name="position_id"/><field name="authorized_fte" type="measure"/></graph></field></record>
    <record id="action_onehr_position_budget" model="ir.actions.act_window"><field name="name">Position Budgets</field><field name="res_model">onehr.position.budget</field><field name="view_mode">list,form,pivot,graph</field><field name="search_view_id" ref="view_onehr_position_budget_search"/></record>
</odoo>
