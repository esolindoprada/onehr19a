<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_onehr_assignment" model="ir.sequence">
        <field name="name">OneHR Assignment</field>
        <field name="code">onehr.assignment</field>
        <field name="prefix">ASN/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_onehr_assignment_change_request" model="ir.sequence">
        <field name="name">OneHR Assignment Movement Request</field>
        <field name="code">onehr.assignment.change.request</field>
        <field name="prefix">MOV/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
