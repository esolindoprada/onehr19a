<odoo>
    <record id="view_onehr_approval_kpi_list" model="ir.ui.view"><field name="name">onehr.approval.kpi.daily.list.enterprise</field><field name="model">onehr.approval.kpi.daily</field><field name="arch" type="xml"><list>
        <field name="snapshot_date"/><field name="company_id" groups="base.group_multi_company"/><field name="rule_id"/><field name="submitted_count"/><field name="pending_count"/><field name="approved_count"/><field name="rejected_count"/><field name="executed_count"/><field name="overdue_count"/><field name="average_cycle_hours"/><field name="average_pending_age_hours"/>
    </list></field></record>
    <record id="view_onehr_approval_kpi_form" model="ir.ui.view"><field name="name">onehr.approval.kpi.daily.form.enterprise</field><field name="model">onehr.approval.kpi.daily</field><field name="arch" type="xml"><form string="Daily Approval KPI Snapshot" create="false" edit="false" delete="false">
        <sheet><div class="oe_button_box" name="button_box"><button class="oe_stat_button" name="action_open_requests" type="object" icon="fa-list"><div class="o_stat_info"><span class="o_stat_text">Source Requests</span></div></button></div><div class="oe_title"><h1><field name="snapshot_date"/></h1></div><group><group><field name="company_id" groups="base.group_multi_company"/><field name="rule_id"/><field name="as_of_at"/></group><group><field name="average_cycle_hours"/><field name="average_pending_age_hours"/></group></group><group string="Volume &amp; SLA"><field name="submitted_count"/><field name="pending_count"/><field name="approved_count"/><field name="rejected_count"/><field name="executed_count"/><field name="overdue_count"/></group></sheet>
    </form></field></record>
    <record id="view_onehr_approval_kpi_search" model="ir.ui.view"><field name="name">onehr.approval.kpi.daily.search.enterprise</field><field name="model">onehr.approval.kpi.daily</field><field name="arch" type="xml"><search><field name="snapshot_date"/><field name="company_id"/><field name="rule_id"/><group><filter name="group_date" string="Snapshot Date" context="{'group_by':'snapshot_date'}"/><filter name="group_rule" string="Rule" context="{'group_by':'rule_id'}"/><filter name="group_company" string="Company" context="{'group_by':'company_id'}" groups="base.group_multi_company"/></group></search></field></record>
    <record id="view_onehr_approval_kpi_pivot" model="ir.ui.view"><field name="name">onehr.approval.kpi.daily.pivot.enterprise</field><field name="model">onehr.approval.kpi.daily</field><field name="arch" type="xml"><pivot string="Approval SLA KPI"><field name="snapshot_date" interval="month" type="row"/><field name="rule_id" type="row"/><field name="company_id" type="col"/><field name="pending_count" type="measure"/><field name="approved_count" type="measure"/><field name="rejected_count" type="measure"/><field name="overdue_count" type="measure"/><field name="average_cycle_hours" type="measure"/></pivot></field></record>
    <record id="view_onehr_approval_kpi_graph" model="ir.ui.view"><field name="name">onehr.approval.kpi.daily.graph.enterprise</field><field name="model">onehr.approval.kpi.daily</field><field name="arch" type="xml"><graph string="Approval SLA Trend" type="line"><field name="snapshot_date" interval="day"/><field name="overdue_count" type="measure"/><field name="average_cycle_hours" type="measure"/></graph></field></record>
    <record id="action_onehr_approval_kpi" model="ir.actions.act_window"><field name="name">Approval SLA KPI</field><field name="res_model">onehr.approval.kpi.daily</field><field name="view_mode">list,pivot,graph,form</field><field name="search_view_id" ref="view_onehr_approval_kpi_search"/></record>
</odoo>
