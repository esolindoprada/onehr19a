<odoo>
    <record id="view_onehr_approval_delegate_list" model="ir.ui.view">
        <field name="name">onehr.approval.delegate.list.enterprise</field><field name="model">onehr.approval.delegate</field>
        <field name="arch" type="xml"><list decoration-success="state == 'active'" decoration-muted="state == 'revoked'">
            <field name="delegator_user_id"/><field name="delegate_user_id"/><field name="scope_type" widget="badge"/><field name="role_id" optional="show"/><field name="rule_id" optional="show"/><field name="valid_from"/><field name="valid_to"/><field name="company_id" groups="base.group_multi_company"/><field name="state" widget="badge"/>
        </list></field>
    </record>
    <record id="view_onehr_approval_delegate_form" model="ir.ui.view">
        <field name="name">onehr.approval.delegate.form.enterprise</field><field name="model">onehr.approval.delegate</field>
        <field name="arch" type="xml"><form string="Approval Delegation">
            <header><button name="action_activate" type="object" string="Activate" class="btn-primary" invisible="state != 'draft'"/><button name="action_revoke" type="object" string="Revoke" invisible="state != 'active'"/><field name="state" widget="statusbar" statusbar_visible="draft,active,revoked"/></header>
            <sheet>
                <div class="oe_button_box" name="button_box"><button class="oe_stat_button" name="action_open_delegator" type="object" icon="fa-user"><div class="o_stat_info"><span class="o_stat_text">Delegator</span></div></button><button class="oe_stat_button" name="action_open_delegate" type="object" icon="fa-user-plus"><div class="o_stat_info"><span class="o_stat_text">Delegate</span></div></button></div>
                <div class="oe_title"><h1>Approval Delegation</h1></div>
                <group><group string="People"><field name="delegator_user_id" readonly="state != 'draft'"/><field name="delegate_user_id" readonly="state != 'draft'"/><field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/></group><group string="Effective Period"><field name="valid_from" readonly="state != 'draft'"/><field name="valid_to" readonly="state == 'revoked'"/></group></group>
                <group string="Authority Scope"><field name="scope_type" readonly="state != 'draft'"/><field name="role_id" invisible="scope_type != 'role'" readonly="state != 'draft'"/><field name="rule_id" invisible="scope_type != 'rule'" readonly="state != 'draft'"/></group>
                <notebook><page string="Reason"><field name="reason" readonly="state != 'draft'"/></page><page string="Activation / Revocation"><group><field name="activated_at" readonly="1"/><field name="activated_by_id" readonly="1"/><field name="revoked_at" readonly="1"/><field name="revoked_by_id" readonly="1"/><field name="revocation_reason" readonly="1"/></group></page></notebook>
            </sheet><chatter/>
        </form></field>
    </record>
    <record id="view_onehr_approval_delegate_search" model="ir.ui.view"><field name="name">onehr.approval.delegate.search.enterprise</field><field name="model">onehr.approval.delegate</field><field name="arch" type="xml"><search>
        <field name="delegator_user_id"/><field name="delegate_user_id"/><field name="role_id"/><field name="rule_id"/><field name="company_id"/><field name="state"/>
        <filter name="active" string="Active" domain="[('state','=','active')]"/><filter name="draft" string="Draft" domain="[('state','=','draft')]"/><filter name="revoked" string="Revoked" domain="[('state','=','revoked')]"/>
        <group><filter name="group_scope" string="Scope Type" context="{'group_by':'scope_type'}"/><filter name="group_delegator" string="Delegator" context="{'group_by':'delegator_user_id'}"/><filter name="group_company" string="Company" context="{'group_by':'company_id'}" groups="base.group_multi_company"/></group>
    </search></field></record>
    <record id="action_onehr_approval_delegations" model="ir.actions.act_window"><field name="name">Approval Delegations</field><field name="res_model">onehr.approval.delegate</field><field name="view_mode">list,form</field><field name="search_view_id" ref="view_onehr_approval_delegate_search"/></record>
</odoo>
