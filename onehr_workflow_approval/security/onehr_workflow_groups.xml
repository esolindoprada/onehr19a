
<odoo>
    <record id="module_category_onehr_approval" model="ir.module.category">
        <field name="name">OneHR Approvals</field>
        <field name="description">OneHR approval request, decision and workflow configuration privileges.</field>
        <field name="sequence">45</field>
    </record>

    <record id="privilege_onehr_approval" model="res.groups.privilege">
        <field name="name">OneHR Approvals</field>
        <field name="description">Approval participation, authority and workflow configuration.</field>
        <field name="category_id" ref="module_category_onehr_approval"/>
        <field name="sequence">45</field>
    </record>

    <record id="group_onehr_approval_user" model="res.groups">
        <field name="name">Approval User</field>
        <field name="privilege_id" ref="privilege_onehr_approval"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[Command.link(ref('onehr_security.group_onehr_security_user'))]"/>
        <field name="comment">May view own/participating approval requests and the role catalogue required to understand routing. No security administration.</field>
    </record>

    <record id="group_onehr_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="privilege_id" ref="privilege_onehr_approval"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[Command.link(ref('onehr_workflow_approval.group_onehr_approval_user'))]"/>
        <field name="comment">May record a decision only when the server resolves the user as an eligible current approver.</field>
    </record>

    <record id="group_onehr_workflow_manager" model="res.groups">
        <field name="name">Workflow Manager</field>
        <field name="privilege_id" ref="privilege_onehr_approval"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[Command.link(ref('onehr_workflow_approval.group_onehr_approver'))]"/>
        <field name="comment">Maintains approval matrix and controlled reassignments. Does not imply OneHR Security Manager/Admin.</field>
    </record>

    <record id="group_onehr_workflow_admin" model="res.groups">
        <field name="name">Workflow Administrator</field>
        <field name="privilege_id" ref="privilege_onehr_approval"/>
        <field name="sequence">40</field>
        <field name="implied_ids" eval="[Command.link(ref('onehr_workflow_approval.group_onehr_workflow_manager'))]"/>
        <field name="comment">Highest approval-engine authority. Does not imply restricted HR data or OneHR Security Admin.</field>
    </record>
</odoo>
