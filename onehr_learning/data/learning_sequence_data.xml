<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_onehr_learning_session" model="ir.sequence">
        <field name="name">OneHR Learning Session</field>
        <field name="code">onehr.learning.session</field>
        <field name="prefix">LSES/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_onehr_learning_enrollment" model="ir.sequence">
        <field name="name">OneHR Learning Enrollment</field>
        <field name="code">onehr.learning.enrollment</field>
        <field name="prefix">LENR/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_onehr_learning_certificate" model="ir.sequence">
        <field name="name">OneHR Learning Certificate</field>
        <field name="code">onehr.learning.certificate</field>
        <field name="prefix">LCERT/%(year)s/</field>
        <field name="padding">6</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
