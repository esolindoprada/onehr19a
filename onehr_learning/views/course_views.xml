<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_onehr_learning_course_list" model="ir.ui.view">
        <field name="name">onehr.learning.course.list.enterprise</field>
        <field name="model">onehr.learning.course</field>
        <field name="arch" type="xml">
            <list decoration-success="published" decoration-muted="not active">
                <field name="code"/>
                <field name="name"/>
                <field name="course_type" widget="badge"/>
                <field name="level" widget="badge"/>
                <field name="duration_hours"/>
                <field name="pass_score"/>
                <field name="published"/>
                <field name="mandatory" optional="show"/>
                <field name="certificate_validity_months" optional="hide"/>
                <field name="training_leave_type_code" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="active" optional="show"/>
                <button name="action_publish" type="object" string="Publish"
                        icon="fa-check-circle" invisible="published"
                        groups="onehr_learning.group_onehr_learning_manager_approver"/>
                <button name="action_validate_prerequisites" type="object" string="Validate"
                        icon="fa-sitemap"
                        groups="onehr_learning.group_onehr_learning_officer"/>
            </list>
        </field>
    </record>

    <record id="view_onehr_learning_course_kanban" model="ir.ui.view">
        <field name="name">onehr.learning.course.kanban.enterprise</field>
        <field name="model">onehr.learning.course</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="code"/>
                <field name="course_type"/>
                <field name="level"/>
                <field name="duration_hours"/>
                <field name="published"/>
                <field name="mandatory"/>
                <field name="session_count"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start">
                            <strong><field name="name"/></strong>
                            <span class="badge text-bg-success" t-if="record.published.raw_value">Published</span>
                        </div>
                        <div class="text-muted"><field name="code"/></div>
                        <div class="mt-2">
                            <field name="course_type"/> · <field name="level"/>
                        </div>
                        <div class="mt-2">
                            <span><field name="duration_hours"/> h</span>
                            <span class="ms-3"><field name="session_count"/> session(s)</span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_onehr_learning_course_form" model="ir.ui.view">
        <field name="name">onehr.learning.course.form.enterprise</field>
        <field name="model">onehr.learning.course</field>
        <field name="arch" type="xml">
            <form string="Learning Course">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_sessions" type="object" class="oe_stat_button"
                                icon="fa-calendar" groups="onehr_learning.group_onehr_learning_officer">
                            <field name="session_count" widget="statinfo" string="Sessions"/>
                        </button>
                        <button name="action_open_enrollments" type="object" class="oe_stat_button"
                                icon="fa-users" groups="onehr_learning.group_onehr_learning_officer">
                            <field name="enrollment_count" widget="statinfo" string="Enrollments"/>
                        </button>
                        <button name="action_open_certificates" type="object" class="oe_stat_button"
                                icon="fa-certificate" groups="onehr_learning.group_onehr_learning_officer">
                            <field name="certificate_count" widget="statinfo" string="Certificates"/>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Published" bg_color="text-bg-success"
                            invisible="not published"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-secondary"
                            invisible="active"/>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Course title"/></h1>
                        <div class="text-muted"><field name="code"/></div>
                    </div>

                    <group>
                        <group string="Catalog">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="course_type"/>
                            <field name="level"/>
                            <field name="default_delivery_mode"/>
                            <field name="mandatory" readonly="1"/>
                            <field name="active"/>
                        </group>
                        <group string="Completion &amp; Certification">
                            <field name="duration_hours"/>
                            <field name="pass_score"/>
                            <field name="certificate_validity_months"/>
                            <field name="certificate_reminder_days"/>
                        </group>
                    </group>

                    <group string="Catalog Actions">
                        <button name="action_publish" type="object" string="Publish Course"
                                class="oe_highlight" icon="fa-check-circle"
                                invisible="published"
                                groups="onehr_learning.group_onehr_learning_manager_approver"/>
                        <button name="action_unpublish" type="object" string="Unpublish"
                                icon="fa-pause-circle" invisible="not published"
                                groups="onehr_learning.group_onehr_learning_manager_approver"/>
                        <button name="action_validate_prerequisites" type="object"
                                string="Validate Prerequisites" icon="fa-sitemap"
                                groups="onehr_learning.group_onehr_learning_officer"/>
                    </group>

                    <notebook>
                        <page string="Overview" name="overview">
                            <group>
                                <field name="description"/>
                                <field name="learning_objectives"/>
                                <field name="target_audience"/>
                            </group>
                        </page>
                        <page string="Curriculum" name="curriculum">
                            <field name="curriculum" nolabel="1"/>
                        </page>
                        <page string="Prerequisites" name="prerequisites">
                            <field name="prerequisite_course_ids"
                                   domain="[('company_id', '=', company_id), ('id', '!=', id)]">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="course_type"/>
                                    <field name="level"/>
                                    <field name="published"/>
                                </list>
                            </field>
                        </page>
                        <page string="Certificate Template" name="certificate_template">
                            <group>
                                <field name="certificate_title"/>
                                <field name="certificate_statement"/>
                                <field name="certificate_signatory_name"/>
                                <field name="certificate_signatory_title"/>
                            </group>
                            <div class="alert alert-info" role="alert">
                                Template text is maintained per Course so Learning remains human-editable
                                without inventing an unapproved certificate-template model.
                            </div>
                        </page>
                        <page string="Soft Integrations" name="integrations">
                            <group>
                                <field name="training_leave_type_code"/>
                                <field name="certificate_document_category_code"/>
                            </group>
                            <div class="alert alert-info" role="alert">
                                Time Off and Document remain soft downstream integrations.
                                No reverse hard dependency or security bypass is introduced.
                            </div>
                        </page>
                    </notebook>
                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_onehr_learning_course_search" model="ir.ui.view">
        <field name="name">onehr.learning.course.search.enterprise</field>
        <field name="model">onehr.learning.course</field>
        <field name="arch" type="xml">
            <search string="Learning Courses">
                <field name="code"/>
                <field name="name"/>
                <field name="course_type"/>
                <field name="level"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="published" string="Published" domain="[('published', '=', True)]"/>
                <filter name="mandatory" string="Mandatory" domain="[('mandatory', '=', True)]"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_type" string="Course Type" context="{'group_by': 'course_type'}"/>
                    <filter name="group_level" string="Level" context="{'group_by': 'level'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_onehr_learning_courses" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">onehr.learning.course</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_onehr_learning_course_search"/>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>
