<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Company is the current legal/security partition. Branch remains a soft downstream extension. -->
    <record id="rule_learning_course_company" model="ir.rule">
        <field name="name">Learning Course — allowed companies</field>
        <field name="model_id" ref="model_onehr_learning_course"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_learning_vendor_company" model="ir.rule">
        <field name="name">Learning Vendor — allowed companies</field>
        <field name="model_id" ref="model_onehr_learning_vendor"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_learning_session_company" model="ir.rule">
        <field name="name">Learning Session — allowed companies</field>
        <field name="model_id" ref="model_onehr_learning_session"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_learning_enrollment_company" model="ir.rule">
        <field name="name">Learning Enrollment — allowed companies</field>
        <field name="model_id" ref="model_onehr_learning_enrollment"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_learning_attendance_company" model="ir.rule">
        <field name="name">Learning Attendance — allowed companies</field>
        <field name="model_id" ref="model_onehr_learning_attendance"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_learning_certificate_company" model="ir.rule">
        <field name="name">Learning Certificate — allowed companies</field>
        <field name="model_id" ref="model_onehr_learning_certificate"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_learning_budget_company" model="ir.rule">
        <field name="name">Learning Budget — allowed companies</field>
        <field name="model_id" ref="model_onehr_learning_budget"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_learning_cost_company" model="ir.rule">
        <field name="name">Learning Cost — allowed companies</field>
        <field name="model_id" ref="model_onehr_learning_cost_line"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Trainers see only sessions assigned to their own Odoo user. -->
    <record id="rule_learning_session_trainer_assigned" model="ir.rule">
        <field name="name">Learning Session — assigned trainer only</field>
        <field name="model_id" ref="model_onehr_learning_session"/>
        <field name="groups" eval="[Command.link(ref('onehr_learning.group_onehr_learning_trainer'))]"/>
        <field name="domain_force">[('trainer_user_id', '=', user.id)]</field>
    </record>
    <record id="rule_learning_enrollment_trainer_assigned" model="ir.rule">
        <field name="name">Learning Enrollment — assigned trainer only</field>
        <field name="model_id" ref="model_onehr_learning_enrollment"/>
        <field name="groups" eval="[Command.link(ref('onehr_learning.group_onehr_learning_trainer'))]"/>
        <field name="domain_force">[('session_id.trainer_user_id', '=', user.id)]</field>
    </record>
    <record id="rule_learning_attendance_trainer_assigned" model="ir.rule">
        <field name="name">Learning Attendance — assigned trainer only</field>
        <field name="model_id" ref="model_onehr_learning_attendance"/>
        <field name="groups" eval="[Command.link(ref('onehr_learning.group_onehr_learning_trainer'))]"/>
        <field name="domain_force">[('session_id.trainer_user_id', '=', user.id)]</field>
    </record>
    <record id="rule_learning_certificate_trainer_assigned" model="ir.rule">
        <field name="name">Learning Certificate — assigned trainer only</field>
        <field name="model_id" ref="model_onehr_learning_certificate"/>
        <field name="groups" eval="[Command.link(ref('onehr_learning.group_onehr_learning_trainer'))]"/>
        <field name="domain_force">[('session_id.trainer_user_id', '=', user.id)]</field>
    </record>

    <!--
        Role-overlap rule:
        an Officer/Manager who also happens to hold Trainer must retain normal
        company-scoped L&D authority. Global company rules above remain authoritative.
    -->
    <record id="rule_learning_session_officer_scope" model="ir.rule">
        <field name="name">Learning Session — Officer company scope</field>
        <field name="model_id" ref="model_onehr_learning_session"/>
        <field name="groups" eval="[Command.link(ref('onehr_learning.group_onehr_learning_officer'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_learning_enrollment_officer_scope" model="ir.rule">
        <field name="name">Learning Enrollment — Officer company scope</field>
        <field name="model_id" ref="model_onehr_learning_enrollment"/>
        <field name="groups" eval="[Command.link(ref('onehr_learning.group_onehr_learning_officer'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_learning_attendance_officer_scope" model="ir.rule">
        <field name="name">Learning Attendance — Officer company scope</field>
        <field name="model_id" ref="model_onehr_learning_attendance"/>
        <field name="groups" eval="[Command.link(ref('onehr_learning.group_onehr_learning_officer'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_learning_certificate_officer_scope" model="ir.rule">
        <field name="name">Learning Certificate — Officer company scope</field>
        <field name="model_id" ref="model_onehr_learning_certificate"/>
        <field name="groups" eval="[Command.link(ref('onehr_learning.group_onehr_learning_officer'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
