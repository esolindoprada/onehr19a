<odoo>
    <record id="rule_onehr_analytics_tile_company" model="ir.rule">
        <field name="name">Analytics KPI Tile — company boundary</field>
        <field name="model_id" ref="model_onehr_analytics_tile"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_onehr_kpi_snapshot_company" model="ir.rule">
        <field name="name">Analytics KPI Snapshot — company boundary</field>
        <field name="model_id" ref="model_onehr_kpi_snapshot"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
