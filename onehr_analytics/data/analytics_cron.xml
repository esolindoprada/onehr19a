<odoo noupdate="1">
    <record id="ir_cron_onehr_analytics_generate_snapshots" model="ir.cron">
        <field name="name">OneHR Analytics — Generate Due KPI Snapshots</field>
        <field name="model_id" ref="model_onehr_analytics_tile"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_due_snapshots()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_onehr_analytics_archive_snapshots" model="ir.cron">
        <field name="name">OneHR Analytics — Archive Historical KPI Evidence</field>
        <field name="model_id" ref="model_onehr_analytics_tile"/>
        <field name="state">code</field>
        <field name="code">model._cron_archive_old_snapshots()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
